<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ExportUI.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ExportUI/Translations/Strings.en.axaml"/>
        <ResourceInclude Source="avares://ExportUI/Sources/Icons/IconResources.axaml"/>
        <ResourceInclude Source="avares://ExportUI/Theme/VetaleSearchThemeDefaults.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ExportUI/Elements/Tab.axaml"/>
    <StyleInclude Source="avares://ExportUI/Elements/NavigationBar.axaml"/>
  </Application.Styles>
</Application>

