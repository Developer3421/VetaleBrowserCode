<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VetaleBrowser.VetaleBrowser.DevTools.Pages.WebViewWorkerPage">

    <UserControl.Styles>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#66BB6A"/>
        </Style>
        <Style Selector="Button.action-button:pressed">
            <Setter Property="Background" Value="#43A047"/>
        </Style>
        <Style Selector="Button.action-button:disabled">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <Style Selector="TextBox.url-box">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="TextBox.url-box:focus">
            <Setter Property="BorderBrush" Value="#4CAF50"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#F8F8F8" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🌐" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DevTools.WebViewWorker.Title}" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{DynamicResource DevTools.WebViewWorker.Description}" 
                           FontSize="12" 
                           Foreground="#666666"/>
            </StackPanel>
        </Border>

        <!-- Current Tab Info -->
        <Border Grid.Row="1" Background="#FFFEF5" Padding="12,6" BorderBrush="#FFE0B0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="📑" FontSize="14"/>
                    <TextBlock Text="{DynamicResource DevTools.WebViewWorker.CurrentTab}" 
                               FontWeight="SemiBold" 
                               FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                    <TextBlock x:Name="CurrentTabTitle" 
                               Text="{DynamicResource DevTools.WebViewWorker.NoActiveTab}" 
                               FontSize="12" 
                               FontWeight="Medium"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CurrentTabUrl" 
                               Text="" 
                               FontSize="11" 
                               Foreground="#666666"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Control Panel -->
        <Border Grid.Row="2" Background="White" Padding="10,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <!-- Navigation Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="3">
                    <Button x:Name="BackButton" 
                            Classes="action-button"
                            Click="OnBackClick"
                            ToolTip.Tip="{DynamicResource DevTools.WebViewWorker.Back}"
                            IsEnabled="False">
                        <TextBlock Text="◀️" FontSize="12"/>
                    </Button>
                    <Button x:Name="ForwardButton" 
                            Classes="action-button"
                            Click="OnForwardClick"
                            ToolTip.Tip="{DynamicResource DevTools.WebViewWorker.Forward}"
                            IsEnabled="False">
                        <TextBlock Text="▶️" FontSize="12"/>
                    </Button>
                    <Button x:Name="RefreshButton" 
                            Classes="action-button"
                            Click="OnRefreshClick"
                            ToolTip.Tip="{DynamicResource DevTools.WebViewWorker.Refresh}">
                        <TextBlock Text="🔄" FontSize="12"/>
                    </Button>
                </StackPanel>

                <!-- Load Current Tab URL -->
                <Button Grid.Column="1" 
                        Classes="action-button"
                        Click="OnLoadCurrentTabUrl"
                        x:Name="LoadCurrentButton"
                        Margin="8,0,0,0"
                        IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📥" FontSize="12"/>
                        <TextBlock Text="{DynamicResource DevTools.WebViewWorker.LoadCurrentTab}"/>
                    </StackPanel>
                </Button>

                <!-- URL Input -->
                <TextBox Grid.Column="3" 
                         x:Name="UrlTextBox"
                         Classes="url-box"
                         Watermark="{DynamicResource DevTools.WebViewWorker.EnterUrl}"
                         Margin="8,0,8,0"
                         KeyDown="OnUrlKeyDown"/>

                <!-- Go Button -->
                <Button Grid.Column="4" 
                        Classes="action-button"
                        Click="OnGoClick"
                        Margin="0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🚀" FontSize="12"/>
                        <TextBlock Text="{DynamicResource DevTools.WebViewWorker.Go}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- WebView Container -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid x:Name="WebViewContainer">
                    <!-- WebView буде доданий програмно -->
                </Grid>
                <TextBlock x:Name="PlaceholderText"
                           Text="WebView Worker готовий&#10;&#10;Введіть URL та натисніть 'Go'&#10;або&#10;Натисніть 'Load HTML from Editor' щоб відкрити створений HTML"
                           FontSize="13"
                           Foreground="#999999"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="True"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#F5F5F5" Padding="10,5" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                    <TextBlock x:Name="StatusIcon" Text="⚪" FontSize="12"/>
                    <TextBlock x:Name="StatusText" 
                               Text="Ready" 
                               FontSize="11" 
                               Foreground="#666666"/>
                </StackPanel>
                
                <!-- Load HTML from Editor Button -->
                <Button Grid.Column="2"
                        Classes="action-button"
                        Click="OnLoadHtmlFromEditor"
                        Margin="0,0,8,0"
                        Background="#FF9800"
                        ToolTip.Tip="Завантажити HTML з редактора та захопити дані">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="📝" FontSize="12"/>
                        <TextBlock Text="Load HTML from Editor"/>
                    </StackPanel>
                </Button>
                
                <TextBlock Grid.Column="3" 
                           x:Name="LoadingProgress"
                           Text=""
                           FontSize="11" 
                           Foreground="#4CAF50"
                           FontWeight="Medium"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

