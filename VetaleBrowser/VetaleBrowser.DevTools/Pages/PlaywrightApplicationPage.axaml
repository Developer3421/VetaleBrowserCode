<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VetaleBrowser.VetaleBrowser.DevTools.Pages.PlaywrightApplicationPage"
             Background="#FF9800">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header with title -->
        <Border Grid.Row="0" 
                Background="#F8F8F8" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="💾" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DevTools.Tab.Application}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="#303030"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CaptureStorageButton"
                            Content="{DynamicResource DevTools.Application.CaptureStorage}" 
                            Click="OnCaptureStorage"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="10,6"
                            Cursor="Hand"/>
                    <Button x:Name="ClearCookiesButton"
                            Content="{DynamicResource DevTools.Application.ClearCookies}" 
                            Click="OnClearCookies"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="10,6"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основний контент -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="15" Background="#FFFFFF">
            <!-- Ліва панель - типи storage -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,8,0" Background="#FAFAFA">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{DynamicResource DevTools.Application.StorageTypes}" FontWeight="SemiBold" Margin="10" Foreground="#303030" FontSize="14"/>
                    <ListBox Grid.Row="1" Name="StorageTypesList" SelectionChanged="OnStorageTypeSelected" Background="Transparent" BorderThickness="0" Margin="10">
                        <ListBoxItem Tag="localStorage">
                            <TextBlock Text="{DynamicResource DevTools.Application.LocalStorage}"/>
                        </ListBoxItem>
                        <ListBoxItem Tag="sessionStorage">
                            <TextBlock Text="{DynamicResource DevTools.Application.SessionStorage}"/>
                        </ListBoxItem>
                        <ListBoxItem Tag="cookies">
                            <TextBlock Text="{DynamicResource DevTools.Application.Cookies}"/>
                        </ListBoxItem>
                        <ListBoxItem Tag="indexedDB">
                            <TextBlock Text="{DynamicResource DevTools.Application.IndexedDB}"/>
                        </ListBoxItem>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Права панель - дані storage -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" Margin="8,0,0,0" Background="#FAFAFA">
                <Grid RowDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Row="0" Name="StorageTypeTitle" Text="{DynamicResource DevTools.Application.SelectStorageType}" FontWeight="SemiBold" Margin="10" Foreground="#303030" FontSize="14"/>
                    
                    <!-- Список елементів -->
                    <ScrollViewer Grid.Row="1" Padding="10">
                        <ListBox Name="StorageDataList" SelectionChanged="OnStorageItemSelected" Background="White" BorderThickness="0"/>
                    </ScrollViewer>

                    <!-- Деталі вибраного елемента -->
                    <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10" Background="#F5F5F5">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,5">
                                <TextBlock Text="{DynamicResource DevTools.Application.Key}" FontWeight="SemiBold"/>
                                <TextBlock Name="SelectedKeyText" Text="-"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="{DynamicResource DevTools.Application.Value}" FontWeight="SemiBold" Margin="0,5,0,2"/>
                            <TextBox Grid.Row="2" Name="SelectedValueText" 
                                   IsReadOnly="True" 
                                   AcceptsReturn="True" 
                                   TextWrapping="Wrap"
                                   MaxHeight="150"
                                   Background="White"
                                   FontFamily="Consolas,Courier New,monospace"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
