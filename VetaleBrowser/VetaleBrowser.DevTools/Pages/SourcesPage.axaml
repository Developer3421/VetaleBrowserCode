<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VetaleBrowser.VetaleBrowser.DevTools.Pages.SourcesPage"
             Background="White">
    
    <UserControl.Styles>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#45a049"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📁" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DevTools.Tool.Sources.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Grid.Column="2" 
                        Classes="action-btn"
                        Click="CaptureSourcesFromWebView"
                        ToolTip.Tip="{DynamicResource DevTools.Sources.CaptureSources.Tooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="🔄" FontSize="14"/>
                        <TextBlock Text="{DynamicResource DevTools.Sources.CaptureFromWebView}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1" ColumnDefinitions="200,4,*">
            
            <!-- File Tree -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" Background="#FAFAFA">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="{DynamicResource DevTools.Sources.Files}" FontWeight="SemiBold" Padding="10,8" Background="#F0F0F0"/>
                    <ScrollViewer Grid.Row="1">
                        <TreeView x:Name="FileTree" SelectionChanged="OnFileSelected" Padding="5">
                            <!-- Will be populated dynamically -->
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Background="#E0E0E0" ResizeDirection="Columns"/>
            
            <!-- Code Viewer -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#F0F0F0" Padding="10,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                    <TextBlock x:Name="FileNameText" Text="{DynamicResource DevTools.Sources.SelectFile}" FontWeight="SemiBold"/>
                </Border>
                
                <ScrollViewer Grid.Row="1" Background="White">
                    <TextBox x:Name="CodeViewer"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="12"
                             Padding="10"
                             BorderThickness="0"
                             Background="#FAFAFA"/>
                </ScrollViewer>
            </Grid>
            
        </Grid>
        
    </Grid>
</UserControl>

