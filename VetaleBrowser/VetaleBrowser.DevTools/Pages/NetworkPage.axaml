<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VetaleBrowser.VetaleBrowser.DevTools.Pages.NetworkPage"
             Background="White">
    
    <UserControl.Styles>
        <Style Selector="Button.action-btn">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-btn:pointerover">
            <Setter Property="Background" Value="#1976D2"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#E3F2FD"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,*">
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="12,8" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="🌐" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DevTools.Tool.Network.Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Classes="action-btn"
                            Click="CaptureNetworkFromWebView"
                            ToolTip.Tip="{DynamicResource DevTools.Network.CaptureNetwork.Tooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🔄" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Network.CaptureNetwork}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="action-btn"
                            Click="ClearNetworkData"
                            ToolTip.Tip="{DynamicResource DevTools.Network.ClearNetwork.Tooltip}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🗑️" FontSize="14"/>
                            <TextBlock Text="{DynamicResource Common.Clear}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Content -->
        <Grid Grid.Row="1" RowDefinitions="*,4,Auto">
            
            <!-- Network Resources List -->
            <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="#F0F0F0" Padding="10,6" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="50,*,100,100,100">
                            <TextBlock Grid.Column="0" Text="{DynamicResource DevTools.Network.Type}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="{DynamicResource DevTools.Network.Url}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="2" Text="{DynamicResource DevTools.Network.Size}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="3" Text="{DynamicResource DevTools.Network.Duration}" FontWeight="SemiBold" FontSize="12"/>
                            <TextBlock Grid.Column="4" Text="{DynamicResource DevTools.Network.Status}" FontWeight="SemiBold" FontSize="12"/>
                        </Grid>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1">
                        <ListBox x:Name="NetworkResourcesList"
                                 SelectionChanged="OnNetworkResourceSelected"
                                 Background="White"
                                 BorderThickness="0">
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- Splitter -->
            <GridSplitter Grid.Row="1" Background="#E0E0E0" ResizeDirection="Rows"/>
            
            <!-- Details Panel -->
            <Border Grid.Row="2" Background="#FAFAFA" Padding="15" MinHeight="150" MaxHeight="300">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock x:Name="ResourceDetailsTitle" Text="{DynamicResource DevTools.Network.SelectResource}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBox x:Name="ResourceDetailsText"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 Background="White"
                                 BorderBrush="#E0E0E0"
                                 BorderThickness="1"
                                 Padding="8"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
        </Grid>
        
    </Grid>
</UserControl>

