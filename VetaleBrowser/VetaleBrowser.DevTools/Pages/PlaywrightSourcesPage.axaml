<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VetaleBrowser.VetaleBrowser.DevTools.Pages.PlaywrightSourcesPage"
             Background="#FF9800">
    
    <Grid RowDefinitions="Auto,*">
        <!-- Header with title -->
        <Border Grid.Row="0" 
                Background="#F8F8F8" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="📁" FontSize="20" VerticalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource DevTools.Tab.Sources}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               VerticalAlignment="Center"
                               Foreground="#303030"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CaptureSourcesButton"
                            Content="{DynamicResource DevTools.Sources.CaptureSources}" 
                            Click="OnCaptureSources"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="10,6"
                            Cursor="Hand"/>
                    <Button x:Name="GetHtmlButton"
                            Content="{DynamicResource DevTools.Sources.GetHtml}" 
                            Click="OnGetHtml"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="10,6"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основний контент -->
        <Grid Grid.Row="1" ColumnDefinitions="250,*" Margin="15" Background="#FFFFFF">
            <!-- Ліва панель - дерево файлів -->
            <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,8,0" Background="#FAFAFA">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Text="{DynamicResource DevTools.Sources.FileTree}" FontWeight="SemiBold" Margin="10" Foreground="#303030" FontSize="14"/>
                    
                    <!-- Фільтр -->
                    <StackPanel Grid.Row="1" Margin="10,0,10,5">
                        <TextBlock Text="{DynamicResource DevTools.Sources.FilterByType}" Margin="0,5,0,2" FontWeight="SemiBold" Foreground="#505050"/>
                        <ComboBox Name="FileTypeFilter" SelectionChanged="OnFilterChanged">
                            <ComboBoxItem Content="{DynamicResource DevTools.Sources.All}" Tag="all" IsSelected="True"/>
                            <ComboBoxItem Content="{DynamicResource DevTools.Sources.Scripts}" Tag="script"/>
                            <ComboBoxItem Content="{DynamicResource DevTools.Sources.Stylesheets}" Tag="stylesheet"/>
                            <ComboBoxItem Content="{DynamicResource DevTools.Sources.Images}" Tag="image"/>
                            <ComboBoxItem Content="{DynamicResource DevTools.Sources.Inline}" Tag="inline"/>
                        </ComboBox>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" Padding="10">
                        <TreeView Name="FileTree" SelectionChanged="OnFileSelected" Background="Transparent" BorderThickness="0"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Права панель - перегляд коду -->
            <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" Margin="8,0,0,0" Background="#FAFAFA">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0" Name="FileNameText" Text="{DynamicResource DevTools.Sources.SelectFile}" FontWeight="SemiBold" Margin="10" Foreground="#303030" FontSize="14"/>
                    
                    <!-- Інформація про файл -->
                    <Border Grid.Row="1" Background="#F5F5F5" Padding="10" Margin="10,0,10,10">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{DynamicResource DevTools.Sources.Type}" FontWeight="SemiBold"/>
                                <TextBlock Name="FileTypeText" Text="-"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{DynamicResource DevTools.Sources.Size}" FontWeight="SemiBold"/>
                                <TextBlock Name="FileSizeText" Text="-"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Перегляд коду -->
                    <ScrollViewer Grid.Row="2" Margin="10,0,10,10">
                        <TextBox Name="CodeViewer" 
                               IsReadOnly="True" 
                               AcceptsReturn="True" 
                               TextWrapping="NoWrap"
                               FontFamily="Consolas,Courier New,monospace"
                               Background="#1E1E1E"
                               Foreground="#D4D4D4"
                               Padding="10"
                               BorderThickness="0"/>
                    </ScrollViewer>

                    <!-- JavaScript executor -->
                    <Border Grid.Row="3" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10" Background="#F5F5F5">
                        <Grid RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="{DynamicResource DevTools.Sources.ExecuteJavaScript}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Grid.Row="1" Name="ScriptInput" 
                                   AcceptsReturn="True" 
                                   Height="60"
                                   TextWrapping="Wrap"
                                   Watermark="{DynamicResource DevTools.Sources.EnterJavaScriptCode}"
                                   FontFamily="Consolas,Courier New,monospace"
                                   Background="White"/>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,5,0,0">
                                <Button x:Name="ExecuteButton"
                                        Content="{DynamicResource DevTools.Sources.Execute}" 
                                        Click="OnExecuteScript"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,6"
                                        Cursor="Hand"/>
                                <TextBlock Name="ScriptResultText" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
