<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <ApplicationIcon>DefaultTabItem.ico</ApplicationIcon>
        <LangVersion>14</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <!-- Cross-platform RuntimeIdentifiers (publish with -r win-x64 / linux-x64 / etc.) -->
        <RuntimeIdentifiers>win-x64;win-x86;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
        
        <!-- MSIX Package Properties -->
        <Authors>Oleh Kurylo</Authors>
        <Company>Oleh Kurylo</Company>
        <Product>Vetale Browser</Product>
        <Description>Vetale Browser - Modern web browser with AI assistant, developer tools, and more.</Description>
        <Copyright>© 2025 Oleh Kurylo. All rights reserved.</Copyright>
        <PackageId>OlehKurylo.VetaleBrowser</PackageId>
        <AssemblyTitle>Vetale Browser</AssemblyTitle>
        <AssemblyName>VetaleBrowser</AssemblyName>
        <Version>1.0.0</Version>
        <FileVersion>1.0.0.0</FileVersion>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        
        <!-- MSIX/AppX specific properties -->
        <AppxPackageName>OlehKurylo.VetaleBrowser</AppxPackageName>
        <AppxPublisher>CN=24CFFBC1-123F-4C1A-A2E3-16ABC6B647E6</AppxPublisher>
        <AppxPublisherDisplayName>Oleh Kurylo</AppxPublisherDisplayName>
        <AppxPackageDisplayName>Vetale Browser</AppxPackageDisplayName>
    </PropertyGroup>

    <!-- Release configuration: single-file, no PDB -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
        <!-- Do NOT hardcode RuntimeIdentifier here; pass -r on publish to target win/linux -->
        <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>

        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        
        <!-- Exclude all PDB files from publish -->
        <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        
        <PublishReadyToRun>false</PublishReadyToRun>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.9" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.9">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>none</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Jint" Version="4.4.2" />
        <PackageReference Include="LiteDB" Version="6.0.0-prerelease.73" />
        <PackageReference Include="LLamaSharp" Version="0.25.0" />
        <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.25.0" Condition="'$(LlamaBackendChoice)' == 'cpu-avx2'" />
        <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.25.0" Condition="'$(LlamaBackendChoice)' == 'vulkan'" />

        <!-- Audio/recording (Windows) -->
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="NAudio.Core" Version="2.2.1" />
        <PackageReference Include="NAudio.WinMM" Version="2.2.1" />

        <PackageReference Include="Microsoft.Agents.AI.Abstractions" Version="1.0.0-preview.251104.1" />
        <PackageReference Include="Microsoft.Playwright" Version="1.56.0" />


        <PackageReference Include="WebViewControl-Avalonia" Version="3.120.10" />

        <!-- Removed Windows-only / non-cross-platform packages -->
        <!-- <PackageReference Include="System.Drawing.Common" Version="10.0.0" /> -->
        <!-- <PackageReference Include="NAudio" Version="2.2.1" /> -->
        <!-- <PackageReference Include="NAudio.Core" Version="2.2.1" /> -->
        <!-- <PackageReference Include="NAudio.WinMM" Version="2.2.1" /> -->

        <!-- Removed commercial audio backend -->
        <!-- <PackageReference Include="ManagedBass" Version="4.0.2" /> -->

        <PackageReference Include="Whisper.net" Version="1.9.0" />
        <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" />

    </ItemGroup>

    <ItemGroup>
      <None Include="Package.appxmanifest" />
      <Folder Include="VetaleBrowser.AI\Model\" />
      <Folder Include="VetaleBrowser.DevTools\" />
      <Folder Include="VetaleBrowser.UI\Helpers\ArchitectureTools\" />
      <Folder Include="VetaleBrowser.VoiceRecognition\Models\" />
      <Folder Include="VetaleBrowser.WebEngine\" />
      <Folder Include="VetaleBrowserOfflineGame\" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaResource Include="VetaleBrowser.UI\Sources\Icons\*.png" />
      <AvaloniaResource Include="VetaleBrowser.UI\Elements\*.axaml" />
      <!-- Include single SettingsButton.png which sits in Sources/ (not Icons/) -->
      <AvaloniaResource Include="VetaleBrowser.UI\Sources\SettingsButton.png" />
      <!-- Removed explicit localization dictionaries include to avoid duplicate assets -->
      <!-- <AvaloniaResource Include="VetaleBrowser.UI\TranslationsDictionaries\*.axaml" /> -->
    </ItemGroup>

    <!-- Copy AI model to output directory -->
    <ItemGroup>
      <None Include="VetaleBrowser.AI\Model\*.gguf" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Exclude PDB files from publish -->
    <ItemGroup Condition="'$(Configuration)' == 'Release'">
      <Content Remove="**\*.pdb" />
      <None Remove="**\*.pdb" />
    </ItemGroup>

    <!-- Remove CefGlueBrowserProcess folder and PDB files after publish -->
    <Target Name="CleanupAfterPublish" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
      <ItemGroup>
        <PdbFiles Include="$(PublishDir)**\*.pdb" />
        <CefGlueFolder Include="$(PublishDir)CefGlueBrowserProcess\" />
      </ItemGroup>
      <Delete Files="@(PdbFiles)" />
      <RemoveDir Directories="@(CefGlueFolder)" Condition="Exists('$(PublishDir)CefGlueBrowserProcess\')" />
      <Message Text="Cleaned up PDB files and CefGlueBrowserProcess folder from publish output" Importance="high" />
    </Target>

    <PropertyGroup>
      <!-- Вибір бекенду LLama: cpu-avx2 або vulkan (за замовчуванням cpu-avx2) -->
      <LlamaBackendChoice Condition="'$(LlamaBackendChoice)' == ''">cpu-avx2</LlamaBackendChoice>
      <LlamaPreferredCpuVariant Condition="'$(LlamaBackendChoice)' == 'cpu-avx2'">avx2</LlamaPreferredCpuVariant>
      <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
      <StartupObject>VetaleBrowser.Program</StartupObject>
      <NuGetAuditLevel>moderate</NuGetAuditLevel>
    </PropertyGroup>

    <!-- Suppress known false-positive vulnerabilities in System.Private.Uri 4.3.0 -->
    <!-- These are mitigated in .NET 10 runtime which uses its own URI implementation -->
    <ItemGroup>
      <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5f2m-466j-3848" />
      <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-x5qj-9vmx-7g6g" />
      <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xhfc-gr8f-ffwc" />
    </ItemGroup>

    <!-- Оставляем только вариант avx2 нативних бібліотек LLamaSharp для усунення конфліктів імен при single-file -->
    <Target Name="PruneLlamaCpuVariants" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveReferences" Condition="'$(LlamaBackendChoice)' == 'cpu-avx2' and '$(LlamaPreferredCpuVariant)' == 'avx2'">
      <ItemGroup>
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx\\'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx512\\'))" />
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\noavx\\'))" />
        <!-- Теж видаляємо avx2 з пакетних runtime-айтемів, щоб уникнути дублювання з явним Content Include -->
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(RuntimeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx2\\'))" />
        <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx\\'))" />
        <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx512\\'))" />
        <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\noavx\\'))" />
        <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(NativeCopyLocalItems.Identity)','runtimes\\win-x64\\native\\avx2\\'))" />
      </ItemGroup>
      <Message Importance="high" Text="[LlamaPruneCPU] Removed all llama CPU runtime/native variants (including avx2); avx2 will be added via Content Include" />
    </Target>

    <!-- Прунінг ResolvedFileToPublish для CPU (не потрібен для Vulkan) -->
    <Target Name="PruneLlamaResolvedFilesToPublish" AfterTargets="ResolvePublishFiles" BeforeTargets="ResolveFileConflicts" Condition="'$(LlamaBackendChoice)' == 'cpu-avx2'">
      <ItemGroup>
        <_LlamaAnyCpu Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLower().Contains('llamasharp.backend.cpu') and $([System.String]::Copy('%(ResolvedFileToPublish.Identity)').ToLower().Contains('runtimes\\win-x64\\native\\'))" />
        <ResolvedFileToPublish Remove="@(_LlamaAnyCpu)" />
      </ItemGroup>
      <Message Importance="high" Text="[LlamaPruneCPU] Removed $([MSBuild]::ValueOrDefault('@(_LlamaAnyCpu-&gt;Count())','0')) llama CPU dlls from ResolvedFileToPublish (we'll copy avx2 via Content)" />
    </Target>

    <!-- Захист від одночасного вибору двох бекендів (якщо хтось вручну додасть обидва) -->
    <Target Name="FailOnMultipleLlamaBackends" BeforeTargets="ResolveReferences" Condition="Exists('$(MSBuildProjectFullPath)')">
      <ItemGroup>
        <_HasCpuBackend Include="LLamaSharp.Backend.Cpu" Condition="'$(LlamaBackendChoice)' == 'cpu-avx2'" />
        <_HasVulkanBackend Include="LLamaSharp.Backend.Vulkan" Condition="'$(LlamaBackendChoice)' == 'vulkan'" />
      </ItemGroup>
      <Error Condition="@(_HasCpuBackend-&gt;Count()) &gt; 0 and @(_HasVulkanBackend-&gt;Count()) &gt; 0" Text="Не можна одночасно мати CPU і Vulkan бекенди LLamaSharp в одному однофайловомуbildungs. Використайте -p:LlamaBackendChoice=cpu-avx2 або -p:LlamaBackendChoice=vulkan." />
    </Target>

    <ItemGroup Condition="'$(LlamaBackendChoice)' == 'vulkan'">
      <PackageReference Update="LLamaSharp.Backend.Cpu" ExcludeAssets="runtime;native" />
    </ItemGroup>
    <Target Name="RemoveCpuBackendForVulkan" AfterTargets="ResolvePackageAssets" BeforeTargets="ResolveReferences" Condition="'$(LlamaBackendChoice)' == 'vulkan'">
      <ItemGroup>
        <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="$([System.String]::Copy('%(RuntimeCopyLocalItems.Identity)').ToLower().Contains('llamasharp.backend.cpu'))" />
        <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="$([System.String]::Copy('%(NativeCopyLocalItems.Identity)').ToLower().Contains('llamasharp.backend.cpu'))" />
      </ItemGroup>
      <Message Importance="high" Text="[LlamaVulkan] Removed all CPU backend native/runtime items for Vulkan build" />
    </Target>

    <ItemGroup Condition="'$(LlamaBackendChoice)' == 'cpu-avx2'">
      <Content Remove="**\llamasharp.backend.cpu\runtimes\win-x64\native\**\*.dll" />
      <Content Include="C:\Users\OLEG\.nuget\packages\llamasharp.backend.cpu\0.25.0\runtimes\win-x64\native\avx2\*.dll">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(FileName)%(Extension)</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <!-- Папка для локальних моделей Whisper у проекті -->
      <Folder Include="VetaleBrowser.VoiceRecognition\Models\" />
    </ItemGroup>

    <ItemGroup>
      <!-- Копіювати всі моделі Whisper (.bin) до вихідної директорії -->
      <Content Include="VetaleBrowser.VoiceRecognition\Models\*.bin">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>%(Filename)%(Extension)</Link>
      </Content>
    </ItemGroup>

    <!-- Copy HexGL offline game files to output directory -->
    <ItemGroup>
      <Content Include="VetaleBrowserOfflineGame\HexGL-master\**\*.*">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>VetaleBrowserOfflineGame\HexGL-master\%(RecursiveDir)%(FileName)%(Extension)</Link>
      </Content>
    </ItemGroup>
</Project>
