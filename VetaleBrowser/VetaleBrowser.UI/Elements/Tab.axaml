<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Elements">
    <!-- Vetale SuperLite color style:
         GrayGradient (window chrome), PurpleGradient (nav bar),
         orange->purple accent (#FFFF8C00 -> #FF9A1CE8),
         nav buttons #FF6D00/#FF8800, address bar #F3E8FF/#4C1D95/#A78BFA -->
    <Design.PreviewWith>
        <StackPanel Spacing="5" Margin="20">
            <controls:Tab Title="Active Tab" IsActive="True" Width="200" />
            <controls:Tab Title="Inactive Tab" IsActive="False" Width="200" />
            <controls:Tab Title="Very Long Tab Title Example" IsActive="False" Width="200" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|Tab">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        CornerRadius="6,6,0,0"
                        Padding="12,0,8,0"
                        ClipToBounds="False">

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- Favicon/Icon -->
                        <Border Grid.Column="0"
                                Width="24"
                                Height="24"
                                Margin="0,0,8,0"
                                CornerRadius="4"
                                Background="#A78BFA">
                            <Grid>

                                <!-- Actual favicon image (renders over fallback when available) -->
                                <Image Source="{TemplateBinding FaviconSource}"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="1"
                                   x:Name="PART_Title"
                                   Text="{TemplateBinding Title}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#4C1D95"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,4,0" />

                        <!-- Mute Button: справжня кнопка муту звуку вкладки -->
                        <Button Grid.Column="2"
                                x:Name="PART_MuteButton"
                                Width="20"
                                Height="20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0"
                                ToolTip.Tip="Вимкнути/увімкнути звук вкладки">
                            <Grid>
                                <!-- Динамік зі звуком (немає муту) -->
                                <Path x:Name="PART_SpeakerOnIcon"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Fill="#4C1D95"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M3,9 L7,9 L12,4 L12,16 L7,11 L3,11 Z M14.5,8.5 A4.5,4.5 0 0 1 14.5,11.5 M17,6 A8,8 0 0 1 17,14" />
                                <!-- Динамік з хрестиком (мут) -->
                                <Path x:Name="PART_SpeakerIcon"
                                      Width="14" Height="14"
                                      Stretch="Uniform"
                                      Fill="#FFFFFF"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsVisible="False"
                                      Data="M3,9 L7,9 L12,4 L12,16 L7,11 L3,11 Z M14,9 L20,15 M20,9 L14,15" />
                            </Grid>
                        </Button>

                        <!-- Close Button -->
                        <Button Grid.Column="3"
                                x:Name="PART_CloseButton"
                                Width="20"
                                Height="20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                IsVisible="{TemplateBinding IsCloseButtonVisible}">
                            <Image Source="{DynamicResource CloseTabButtonImage}"
                                   Width="14"
                                   Height="14"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Base Tab background (SuperLite gray chrome) - overridden by state styles below -->
    <Style Selector="controls|Tab /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFE0E0E0" Offset="0" />
                <GradientStop Color="#FFD0D0D0" Offset="0.3" />
                <GradientStop Color="#FFC5C5C5" Offset="0.7" />
                <GradientStop Color="#FFC0C0C0" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="#30000000" />
    </Style>

    <!-- Inactive Tab State (Default, SuperLite gray chrome) -->
    <Style Selector="controls|Tab:not(:active)">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="controls|Tab:not(:active) /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFE0E0E0" Offset="0" />
                <GradientStop Color="#FFD0D0D0" Offset="0.3" />
                <GradientStop Color="#FFC5C5C5" Offset="0.7" />
                <GradientStop Color="#FFC0C0C0" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="#30000000" />
    </Style>

    <!-- Active Tab State (SuperLite purple nav gradient) -->
    <Style Selector="controls|Tab:active">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="controls|Tab:active /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFFF9500" Offset="0" />
                <GradientStop Color="#FFFF7A00" Offset="0.3" />
                <GradientStop Color="#FFFF8C00" Offset="0.45" />
                <GradientStop Color="#FFB14BF4" Offset="0.65" />
                <GradientStop Color="#FF9A1CE8" Offset="0.85" />
                <GradientStop Color="#FF7C1FD6" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="#FFFF8C00" />
    </Style>

    <Style Selector="controls|Tab:active /template/ TextBlock#PART_Title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Hover Effects -->
    <Style Selector="controls|Tab:pointerover /template/ Border#PART_Border">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="controls|Tab:not(:active):pointerover /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF3E8FF" Offset="0" />
                <GradientStop Color="#FFE9D5FF" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <!-- Close Button Hover -->
    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pointerover">
        <Setter Property="Background" Value="#50FFFFFF" />
    </Style>

    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pointerover /template/ Image">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Close Button Press -->
    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pressed">
        <Setter Property="Background" Value="#40FF5C5C" />
    </Style>

    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pressed /template/ Image">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Mute Button Hover -->
    <Style Selector="controls|Tab /template/ Button#PART_MuteButton:pointerover">
        <Setter Property="Background" Value="#20A78BFA" />
    </Style>

    <!-- Mute Button Press -->
    <Style Selector="controls|Tab /template/ Button#PART_MuteButton:pressed">
        <Setter Property="Background" Value="#50FFFFFF" />
    </Style>

    <!-- Mute Button - Muted State Background (SuperLite nav orange) -->
    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton">
        <Setter Property="Background" Value="#FF6D00" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton:pointerover">
        <Setter Property="Background" Value="#FF8800" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton:pressed">
        <Setter Property="Background" Value="#FF6D00" />
    </Style>

    <!-- Mute Button Icon Colors -->
    <Style Selector="controls|Tab[IsMuted=false] /template/ Path#PART_SpeakerIcon">
        <Setter Property="Fill" Value="#4C1D95" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Path#PART_SpeakerIcon">
        <Setter Property="Fill" Value="#FFFFFF" />
    </Style>

    <!-- Перемикання іконок динаміка за станом муту -->
    <Style Selector="controls|Tab[IsMuted=false] /template/ Path#PART_SpeakerOnIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="controls|Tab[IsMuted=false] /template/ Path#PART_SpeakerIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="controls|Tab[IsMuted=true] /template/ Path#PART_SpeakerOnIcon">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="controls|Tab[IsMuted=true] /template/ Path#PART_SpeakerIcon">
        <Setter Property="IsVisible" Value="True" />
    </Style>
</Styles>
