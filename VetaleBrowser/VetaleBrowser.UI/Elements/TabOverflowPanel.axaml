<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Elements">
    
    <Design.PreviewWith>
        <controls:TabOverflowPanel Width="600" />
    </Design.PreviewWith>

    <Style Selector="controls|TabOverflowPanel">
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto">
                    <!-- Overflow tabs container -->
                    <ScrollViewer Grid.Column="0" 
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PART_TabsContainer"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Margin="4,0"/>
                    </ScrollViewer>
                    
                    <!-- Close all button - styled like window close button -->
                    <Button Grid.Column="1"
                            x:Name="PART_CloseAllButton"
                            Width="36"
                            Height="28"
                            Margin="4,0,4,0"
                            Background="Transparent"
                            CornerRadius="4"
                            ToolTip.Tip="Закрити вікно додаткових вкладок"
                            Padding="0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <Path Data="M6,6 L18,18 M18,6 L6,18"
                              Stroke="#606060"
                              StrokeThickness="1.5"
                              StrokeLineCap="Round"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Hover effect for close button -->
    <Style Selector="controls|TabOverflowPanel /template/ Button#PART_CloseAllButton:pointerover">
        <Setter Property="Background" Value="#40FF5C5C" />
    </Style>
    
    <Style Selector="controls|TabOverflowPanel /template/ Button#PART_CloseAllButton:pointerover Path">
        <Setter Property="Stroke" Value="#FF000000" />
    </Style>
    
    <Style Selector="controls|TabOverflowPanel /template/ Button#PART_CloseAllButton:pressed">
        <Setter Property="Background" Value="#60FF5C5C" />
    </Style>
</Styles>

