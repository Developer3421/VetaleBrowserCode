<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="420"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.GeminiApiKeyWindow"
        Title="{DynamicResource Gemini.ApiKey.Title}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF8B4513"
        BorderThickness="1"
        BorderBrush="#22000000"
        CanResize="False"
        Width="550"
        Height="420"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GeminiGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4285F4" Offset="0"/>
            <GradientStop Color="#9C27B0" Offset="0.5"/>
            <GradientStop Color="#EA4335" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
        
        <!-- Primary Button Style -->
        <Style Selector="Button.primary-btn">
            <Setter Property="Background" Value="#4285F4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.primary-btn:pointerover">
            <Setter Property="Background" Value="#5C9CFC"/>
        </Style>
        <Style Selector="Button.primary-btn:pressed">
            <Setter Property="Background" Value="#3367D6"/>
        </Style>
        
        <!-- Secondary Button Style -->
        <Style Selector="Button.secondary-btn">
            <Setter Property="Background" Value="#9C27B0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.secondary-btn:pointerover">
            <Setter Property="Background" Value="#B040C0"/>
        </Style>
        <Style Selector="Button.secondary-btn:pressed">
            <Setter Property="Background" Value="#7B1FA2"/>
        </Style>

        <!-- Link Button Style -->
        <Style Selector="Button.link-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#4285F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-btn:pointerover">
            <Setter Property="Foreground" Value="#5C9CFC"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Height="42" Background="{StaticResource GrayGradient}" PointerPressed="TopBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Left: Gemini icon and title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="✨" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{DynamicResource Gemini.ApiKey.Title}" FontWeight="SemiBold" Foreground="#202020" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Close button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,4,0">
                    <Button Classes="window-control close" Click="CloseWindow_Click" ToolTip.Tip="{DynamicResource Window.Close}">✕</Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Content area -->
        <Border Grid.Row="1" Background="Beige" CornerRadius="0,0,8,8" Margin="0,2,0,0">
            <ScrollViewer>
                <StackPanel Margin="32,24,32,32" Spacing="20">
                    
                    <!-- Header -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Gemini.ApiKey.Header}" 
                                   FontSize="22" FontWeight="Bold" 
                                   Foreground="#1A1A1A"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Gemini.ApiKey.Description}" 
                                   FontSize="14" 
                                   Foreground="#555555"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- API Key input -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource Gemini.ApiKey.Label}" 
                                   FontSize="14" FontWeight="SemiBold" 
                                   Foreground="#333333"/>
                        <TextBox x:Name="ApiKeyTextBox"
                                 Watermark="{DynamicResource Gemini.ApiKey.Watermark}"
                                 FontSize="14"
                                 Padding="12,10"
                                 CornerRadius="6"
                                 Background="White"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"/>
                    </StackPanel>

                    <!-- How to get key section -->
                    <Border Background="#F0F4FF" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{DynamicResource Gemini.ApiKey.HowToGet}" 
                                       FontSize="14" FontWeight="SemiBold" 
                                       Foreground="#4285F4"/>
                            <TextBlock Text="{DynamicResource Gemini.ApiKey.Step1}" 
                                       FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Gemini.ApiKey.Step2}" 
                                       FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource Gemini.ApiKey.Step3}" 
                                       FontSize="13" Foreground="#555555" TextWrapping="Wrap"/>
                            <Button Classes="link-btn" 
                                    x:Name="OpenAIStudioButton"
                                    Click="OpenAIStudio_Click"
                                    Content="{DynamicResource Gemini.ApiKey.OpenAIStudio}"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <Grid ColumnDefinitions="*,Auto,16,Auto,*" Margin="0,8,0,0">
                        <Button Grid.Column="1" 
                                Classes="primary-btn"
                                x:Name="UseCustomKeyButton"
                                Click="UseCustomKey_Click"
                                Content="{DynamicResource Gemini.ApiKey.UseCustomKey}"/>
                        <Button Grid.Column="3" 
                                Classes="secondary-btn"
                                x:Name="UseDefaultKeyButton"
                                Click="UseDefaultKey_Click"
                                Content="{DynamicResource Gemini.ApiKey.UseDefaultKey}"/>
                    </Grid>

                    <!-- Info note -->
                    <TextBlock Text="{DynamicResource Gemini.ApiKey.Note}" 
                               FontSize="12" 
                               Foreground="#777777"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>

