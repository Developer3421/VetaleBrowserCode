<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="650"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.UserAgreementWindow"
        Title="{DynamicResource UserAgreement.TitleView}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF8B4513"
        BorderThickness="1"
        BorderBrush="#22000000"
        CanResize="True"
        MinWidth="450"
        MinHeight="400"
        Width="600"
        Height="650"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF8C00" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Theme/SuperLiteWindow.axaml"/>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Height="40" Background="{StaticResource GrayGradient}" PointerPressed="TopBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="📄" FontSize="20" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBlock Grid.Column="1" Text="{DynamicResource UserAgreement.Header}" FontWeight="SemiBold" Foreground="#202020" VerticalAlignment="Center"/>
                <Border Grid.Column="2"/>
                <Button Grid.Column="3" Classes="window-control close" Click="CloseWindow" Padding="8" BorderThickness="0">
                    <Image Source="{DynamicResource CloseButtonImage}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Content area: full agreement, view only -->
        <Border Grid.Row="1" Background="#FFFFFF" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="30,25,30,25">
                    <TextBlock Text="Vetale Browser" FontSize="24" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Header}" FontSize="16" FontWeight="SemiBold" Foreground="#7C1FD6" HorizontalAlignment="Center"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Welcome}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Introduction}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <Border Height="1" Background="#E0E0E0" Margin="0,5"/>
                    <TextBlock Text="{DynamicResource UserAgreement.GDPR.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.GDPR.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Components.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Search.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Search.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.MediaSearch.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.MediaSearch.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.AI.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.AI.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Voice.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Voice.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Web.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Web.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Favicon.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Favicon.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Security.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Security.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Download.Title}" FontSize="13" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Download.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <Border Height="1" Background="#E0E0E0" Margin="0,5"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item1}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item2}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item3}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item4}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item5}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.LocalStorage.Item6}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Item1}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Item2}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Item3}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Item4}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Rights.Item5}" TextWrapping="Wrap" FontSize="13" Foreground="#555555"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Disclaimer.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Disclaimer.VetaleSearch}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Disclaimer.NoResponsibility}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Contact.Title}" FontSize="14" FontWeight="SemiBold" Foreground="#333333" TextWrapping="Wrap"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Contact.Description}" TextWrapping="Wrap" FontSize="13" Foreground="#555555" LineHeight="20"/>
                    <TextBlock Text="{DynamicResource UserAgreement.Version}" FontSize="12" Foreground="#999999" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons: view only -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="0,0,10,10" Padding="20,10,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="CloseButton" Content="{DynamicResource Window.Close}" Width="120" Height="36" CornerRadius="6"
                        Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="OnCloseClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
