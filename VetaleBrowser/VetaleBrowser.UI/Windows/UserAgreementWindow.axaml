<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="600"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.UserAgreementWindow"
        Title="User Agreement"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF8B4513"
        BorderThickness="1"
        BorderBrush="#22000000"
        CanResize="True"
        MinWidth="450"
        MinHeight="400"
        Width="550"
        Height="600"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF8C00" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Top bar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Height="42" Background="{StaticResource GrayGradient}" PointerPressed="TopBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="📄" FontSize="20" VerticalAlignment="Center" Margin="12,0,8,0"/>
                <TextBlock Grid.Column="1" Text="User Agreement" FontWeight="SemiBold" Foreground="#202020" VerticalAlignment="Center"/>
                <Border Grid.Column="2"/>
                <Button Grid.Column="3" Classes="window-control close" Click="CloseWindow" Padding="0" BorderThickness="0">
                    <Image Source="{DynamicResource CloseButtonImage}" Stretch="UniformToFill"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Content area -->
        <Border Grid.Row="1" Background="#FFFFFF" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="30,25,30,25">
                    <TextBlock Text="Vetale Browser" FontSize="24" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                    <TextBlock Text="User Agreement" FontSize="16" FontWeight="SemiBold" Foreground="#7C1FD6" HorizontalAlignment="Center"/>
                    <Border Height="1" Background="#E0E0E0" Margin="0,5"/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#555555" LineHeight="22" Text="By using Vetale Browser you agree to use the application for lawful purposes only. The browser is provided &quot;as is&quot;, without warranties of any kind. Browsing history, bookmarks and settings are stored locally on your device. AI features may send your queries to third-party services (Google Gemini, search providers) to generate responses. You are responsible for complying with the terms of the websites and services you visit. The developers are not liable for any damages arising from the use of this software."/>
                    <TextBlock TextWrapping="Wrap" FontSize="14" Foreground="#555555" LineHeight="22" Text="You can review this agreement at any time from Tools. If you do not agree with these terms, please decline and close the application."/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="0,0,4,4" Padding="20,10,20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button x:Name="DeclineButton" Content="Decline" Width="120" Height="36" CornerRadius="6"
                        Background="#E0E0E0" Foreground="#333333" Click="OnDeclineClick"/>
                <Button x:Name="AcceptButton" Content="Accept" Width="120" Height="36" CornerRadius="6"
                        Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="SemiBold" Click="OnAcceptClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>

