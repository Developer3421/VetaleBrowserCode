<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pages="clr-namespace:VetaleBrowser.VetaleBrowser.DevTools.Pages"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.DevToolsWindow"
        Title="{DynamicResource DevTools.Title}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF8B4513"
        BorderThickness="1"
        BorderBrush="#22000000"
        CanResize="True"
        MinWidth="800"
        MinHeight="600"
        Width="1000"
        Height="700"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
        
        <!-- Зелені відтінки для всіх кнопок -->
        <Style Selector="Button:not(.window-control):not(.tab-button)">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button:not(.window-control):not(.tab-button):pointerover">
            <Setter Property="Background" Value="#66BB6A"/>
        </Style>
        <Style Selector="Button:not(.window-control):not(.tab-button):pressed">
            <Setter Property="Background" Value="#43A047"/>
        </Style>

        <!-- Tab buttons -->
        <Style Selector="Button.tab-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#505050"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.tab-button:pointerover">
            <Setter Property="Background" Value="#20000000"/>
        </Style>
        <Style Selector="Button.tab-button.active">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top bar: 42px height, gray gradient -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Height="42" Background="{StaticResource GrayGradient}" PointerPressed="TopBar_PointerPressed" DoubleTapped="TopBar_DoubleTapped">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                <!-- Left: DevTools icon -->
                <TextBlock Grid.Column="0" Text="🔧" FontSize="24" Margin="8,0,6,0" VerticalAlignment="Center"/>

                <!-- Vetale Browser button -->
                <Button Grid.Column="1" x:Name="PART_OpenMainButton" Click="OpenMainWindow" Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                    <TextBlock Text="{DynamicResource App.Title}" FontWeight="SemiBold" Foreground="#202020"/>
                </Button>

                <!-- Spacer -->
                <Border Grid.Column="2"/>

                <!-- Window control buttons -->
                <Button Grid.Column="3" Classes="window-control" Click="MinimizeWindow" ToolTip.Tip="{DynamicResource Window.Minimize}" Padding="0">
                    <Image Source="{DynamicResource MinButtonImage}" Stretch="Uniform"/>
                </Button>
                <Button Grid.Column="4" Classes="window-control close" Click="CloseWindow" ToolTip.Tip="{DynamicResource Window.Close}" Padding="0" BorderThickness="0">
                    <Image Source="{DynamicResource CloseButtonImage}" Stretch="UniformToFill"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Tabs Navigation Bar -->
        <Border Grid.Row="1" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TabsPanel" Orientation="Horizontal" Margin="10,0">
                    <Button Classes="tab-button active" x:Name="TabMain" Click="ShowMainPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🏠" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Main}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabElements" Click="ShowElementsPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🔍" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Elements}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabNetwork" Click="ShowNetworkPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌐" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Network}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabSources" Click="ShowSourcesPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="📁" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Sources}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabHtmlEditor" Click="ShowHtmlEditorPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✏️" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.HtmlEditor}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabApplication" Click="ShowApplicationPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="💾" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Application}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabPerformance" Click="ShowPerformancePage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⚡" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.Performance}"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tab-button" x:Name="TabWebViewWorker" Click="ShowWebViewWorkerPage">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="🌐" FontSize="14"/>
                            <TextBlock Text="{DynamicResource DevTools.Tab.WebViewWorker}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2" x:Name="ContentArea" Background="#FFFFFF">
            <ContentControl x:Name="PART_ContentHost" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>
    </Grid>
</Window>


