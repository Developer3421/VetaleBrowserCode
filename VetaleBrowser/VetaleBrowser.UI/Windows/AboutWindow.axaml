<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="550" d:DesignHeight="775"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.AboutWindow"
        Title="{DynamicResource About.Title}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#FF8B4513"
        BorderThickness="1"
        BorderBrush="#22000000"
        CanResize="True"
        MinWidth="450"
        MinHeight="500"
        Width="550"
        Height="775"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Top bar -->
        <Grid x:Name="TopBarGrid" Grid.Row="0" Height="42" Background="{StaticResource GrayGradient}" PointerPressed="TopBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <!-- Left: info icon -->
                <TextBlock Grid.Column="0" Text="ℹ️" FontSize="20" VerticalAlignment="Center" Margin="12,0,8,0"/>

                <!-- Title -->
                <TextBlock Grid.Column="1" Text="{DynamicResource About.Title}" FontWeight="SemiBold" Foreground="#202020" VerticalAlignment="Center"/>

                <!-- Spacer -->
                <Border Grid.Column="2"/>

                <!-- Close button -->
                <Button Grid.Column="3" Classes="window-control close" Click="CloseWindow" ToolTip.Tip="{DynamicResource Window.Close}" Padding="0" BorderThickness="0">
                    <Image Source="{DynamicResource CloseButtonImage}" Stretch="UniformToFill"/>
                </Button>
            </Grid>
        </Grid>

        <!-- Content area -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="0,0,4,4" ClipToBounds="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="20" Margin="30,25,30,25">
                    <!-- Logo and Name -->
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Border Width="80" Height="80" CornerRadius="16" Background="#4CAF50" HorizontalAlignment="Center">
                            <Image Source="{DynamicResource VetaleSearchIconImage}"
                                   Width="40" Height="40"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Vetale Browser" FontSize="28" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource About.Version}" FontSize="14" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Height="1" Background="#E0E0E0" Margin="0,5"/>

                    <!-- Creator Info -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource About.Creator.Label}" FontSize="13" Foreground="#888888"/>
                        <TextBlock Text="{DynamicResource About.Creator.Name}" FontSize="18" FontWeight="SemiBold" Foreground="#333333"/>
                    </StackPanel>

                    <!-- Creation Date -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource About.CreationDate.Label}" FontSize="13" Foreground="#888888"/>
                        <TextBlock Text="{DynamicResource About.CreationDate.Value}" FontSize="16" Foreground="#333333"/>
                    </StackPanel>

                    <!-- Description -->
                    <Border Background="#F5F5F5" CornerRadius="8" Padding="15">
                        <TextBlock Text="{DynamicResource About.Description}" 
                                   FontSize="14" 
                                   Foreground="#555555" 
                                   TextWrapping="Wrap"
                                   LineHeight="22"/>
                    </Border>

                    <!-- Technologies -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource About.Technologies.Label}" FontSize="13" Foreground="#888888"/>
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border Background="#E3F2FD" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="Avalonia UI" FontSize="12" Foreground="#1976D2"/>
                            </Border>
                            <Border Background="#E8F5E9" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="C# / .NET 10" FontSize="12" Foreground="#388E3C"/>
                            </Border>
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="CefGlue" FontSize="12" Foreground="#F57C00"/>
                            </Border>
                            <Border Background="#F3E5F5" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="LlamaSharp" FontSize="12" Foreground="#7B1FA2"/>
                            </Border>
                            <Border Background="#FFEBEE" CornerRadius="4" Padding="8,4" Margin="0,0,8,8">
                                <TextBlock Text="LiteDB" FontSize="12" Foreground="#C62828"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Copyright -->
                    <TextBlock Text="{DynamicResource About.Copyright}" 
                               FontSize="12" 
                               Foreground="#999999" 
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>


