<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.AboutWindow"
        Title="{DynamicResource About.Title}"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        BorderThickness="0"
        CanResize="True"
        MinWidth="420"
        MinHeight="360"
        Width="500" Height="450"
        Padding="0"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        UseLayoutRounding="True"
        TransparencyLevelHint="AcrylicBlur">

    <Window.Resources>
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitleOrangeBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFFF9500" Offset="0"/>
            <GradientStop Color="#FFFF5E00" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TitlePurpleBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FFB14BF4" Offset="0"/>
            <GradientStop Color="#FF7C1FD6" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Theme/SuperLiteWindow.axaml"/>
        <Style Selector="Button:not(.window-control)">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button:not(.window-control):pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
        </Style>
        <Style Selector="Button:not(.window-control):pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
        </Style>
        <Style Selector="Button#PART_OpenMainButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Styles>

    <Border BorderBrush="#30000000" BorderThickness="1" CornerRadius="10" Background="{StaticResource GrayGradient}">
        <Grid RowDefinitions="40,8,*,Auto">
            <!-- Title bar (like Lite) -->
            <Border Grid.Row="0" x:Name="TopBarGrid" Background="Transparent" CornerRadius="10,10,0,0"
                    PointerPressed="TopBar_PointerPressed" DoubleTapped="TopBar_DoubleTapped">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                    <Image Grid.Column="0" Source="{DynamicResource AppIconImage}" Width="18" Height="18" Stretch="Uniform" Margin="14,0,8,0" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="PART_OpenMainButton" Click="OpenMainWindow" Background="Transparent" BorderThickness="0" Padding="6,4" Cursor="Hand">
                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center">
                            <Run Text="Vetale " Foreground="{StaticResource TitleOrangeBrush}"/>
                            <Run Text="{DynamicResource About.TitleShort}" Foreground="{StaticResource TitlePurpleBrush}"/>
                        </TextBlock>
                    </Button>
                    <Border Grid.Column="2"/>
                    <Button Grid.Column="3" Classes="window-control" Click="MinimizeWindow" ToolTip.Tip="{DynamicResource Window.Minimize}" Padding="8">
                        <Image Source="{DynamicResource MinButtonImage}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="4" Classes="window-control close" Click="CloseWindow" ToolTip.Tip="{DynamicResource Window.Close}" Padding="8" BorderThickness="0" Margin="0,0,8,0">
                        <Image Source="{DynamicResource CloseButtonImage}" Stretch="Uniform" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Purple band + white content (like Lite: 16,14 margin, centered) -->
            <Border Grid.Row="2" Background="{StaticResource PurpleGradient}" BorderBrush="#30000000"
                    BorderThickness="0,1,0,1" Margin="8,0" CornerRadius="6">
                <Border Background="White" CornerRadius="6" Margin="8,6" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,14" VerticalAlignment="Center" Spacing="0">
                            <Image Source="{DynamicResource AppIconImage}"
                                   Width="96" Height="96" Stretch="Uniform"
                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock FontSize="20" FontWeight="Bold" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center">
                                <Run Text="Vetale " Foreground="#FFFF6D00"/>
                                <Run Text="Browser" Foreground="#FF7C3AED"/>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource About.Version}" Foreground="#4C1D95" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Foreground="#4C1D95" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0" TextAlignment="Center">
                                <Run Text="{DynamicResource About.Creator.Label}"/>
                                <Run Text=": "/>
                                <Run Text="{DynamicResource About.Creator.Name}"/>
                            </TextBlock>
                            <TextBlock Foreground="#4C1D95" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" TextAlignment="Center">
                                <Run Text="{DynamicResource About.CreationDate.Label}"/>
                                <Run Text=": "/>
                                <Run Text="{DynamicResource About.CreationDate.Value}"/>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource About.Description}" Foreground="#4C1D95" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource About.Technologies.Value}" Foreground="#4C1D95" FontSize="13" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            <TextBlock Text="{DynamicResource About.Copyright}" Foreground="#4C1D95" FontSize="13" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,8,12,10">
                <Button Content="{DynamicResource About.Close}" Click="CloseWindow" Margin="0" MinWidth="90"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
