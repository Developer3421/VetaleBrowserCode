<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Elements"
        mc:Ignorable="d"
        x:Class="VetaleBrowser.VetaleBrowser.UI.Windows.TabOverflowWindow"
        Title="Додаткові вкладки"
        Width="600"
        Height="54"
        MinWidth="250"
        MinHeight="54"
        MaxHeight="54"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Background="Transparent"
        BorderThickness="0"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Padding="0"
        TransparencyLevelHint="Transparent"
        UseLayoutRounding="True">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Завантажуємо іконки -->
                <ResourceInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Sources/Icons/IconResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Сірий градієнт як в головному вікні -->
            <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFE0E0E0" Offset="0"/>
                <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
                <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
                <GradientStop Color="#FFC0C0C0" Offset="1"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Window.Resources>
    
    <Window.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Elements/Tab.axaml"/>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Theme/SuperLiteWindow.axaml"/>
    </Window.Styles>
    
    <!-- Основний контент вікна -->
    <Border Background="{StaticResource GrayGradient}"
            CornerRadius="10"
            ClipToBounds="True"
            BorderThickness="1"
            BorderBrush="#44000000"
            Margin="4"
            x:Name="DragBorder"
            PointerPressed="OnDragBorderPointerPressed">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Drag handle -->
            <Border Grid.Column="0"
                    Width="24"
                    Background="Transparent"
                    Cursor="SizeAll"
                    ToolTip.Tip="{DynamicResource Window.DragToMove}"
                    x:Name="DragHandle"
                    PointerPressed="OnDragHandlePointerPressed">
                <TextBlock Text="⋮⋮" 
                           FontSize="14" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"
                           Foreground="#666666"/>
            </Border>
            
            <!-- Контейнер для вкладок -->
            <ScrollViewer Grid.Column="1" 
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          x:Name="TabsScrollViewer">
                <StackPanel x:Name="TabsContainer"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Spacing="4"
                            Margin="4,0,4,0"/>
            </ScrollViewer>
            
            <!-- Кнопка закриття вікна -->
            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Classes="window-control close"
                    ToolTip.Tip="{DynamicResource Window.CloseAllTabs}"
                    Margin="4,0,8,0"
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center">
                <Image Source="{DynamicResource CloseButtonImage}" 
                       Stretch="UniformToFill"
                       Width="16"
                       Height="16"/>
            </Button>
        </Grid>
    </Border>
</Window>

