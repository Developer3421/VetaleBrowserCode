<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.VideoFullscreenPage">

    <!-- Video fullscreen page: single WebView element, no browser chrome.
         Used for HTML5 video fullscreen (YouTube "F"): the normal page goes
         off-screen, only the WebView is presented fullscreen. -->
    <Grid Name="VideoContainer" Background="#000000">
        <!-- Active tab WebView is placed here -->
    </Grid>
</UserControl>
