<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Elements"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.NormalModePage"
             Background="#FF9800">

    <UserControl.Resources>
        <!-- Футуристичний сірий градієнт -->
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Футуристичний фіолетовий градієнт -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <UserControl.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Elements/Tab.axaml"/>
        
        <!-- Toolbar buttons etc. (kept minimal) -->
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>

        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
        
        <!-- New Window Button Style -->
        <Style Selector="Button#PART_NewWindowButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>
        <Style Selector="Button#PART_NewWindowButton:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
            </Setter>
        </Style>
        <Style Selector="Button#PART_NewWindowButton:pressed">
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="RenderTransform">
                <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top row: tab bar with window controls -->
        <Grid Name="TabBarRow" Grid.Row="0" Margin="0" Height="42" 
              Background="{StaticResource GrayGradient}">
            <Grid ColumnDefinitions="*,Auto">
                <!-- left area - tabs -->
                <StackPanel Name="TabsHost" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,4,0,0" Spacing="4">
                    <!-- Add Tab Button (left of tabs) -->
                    <Button Name="PART_AddTabButton" Width="32" Height="32" Margin="0,0,4,0" Background="Transparent" Padding="0" BorderThickness="0" ToolTip.Tip="{DynamicResource Tab.NewTab}">
                        <Image Source="{DynamicResource AddTabImage}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"/>
                    </Button>
                    <!-- New Window Button -->
                    <Button Name="PART_NewWindowButton" Width="32" Height="32" Margin="0,0,8,0" Padding="0" BorderThickness="0" ToolTip.Tip="{DynamicResource Window.NewWindow}" CornerRadius="6">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFF6B00" Offset="0"/>
                                <GradientStop Color="#FFFF8C00" Offset="0.3"/>
                                <GradientStop Color="#FF9B30FF" Offset="0.7"/>
                                <GradientStop Color="#FF8A2BE2" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <!-- Window icon with plus -->
                                <Rectangle Width="16" Height="12" Canvas.Left="2" Canvas.Top="6" Stroke="White" StrokeThickness="2" Fill="Transparent" RadiusX="1" RadiusY="1"/>
                                <Line StartPoint="18,4" EndPoint="18,12" Stroke="White" StrokeThickness="2.5"/>
                                <Line StartPoint="14,8" EndPoint="22,8" Stroke="White" StrokeThickness="2.5"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
                
                <!-- window controls on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="MinimizeButton" Classes="window-control" ToolTip.Tip="{DynamicResource Window.Minimize}" Padding="0">
                        <Image Source="{DynamicResource MinButtonImage}" Stretch="Uniform"/>
                    </Button>
                    <Button Name="MaximizeButton" Classes="window-control" ToolTip.Tip="{DynamicResource Window.Maximize}" Padding="0">
                        <Image Source="{DynamicResource MaxButtonImage}" Stretch="Uniform"/>
                    </Button>
                    <Button Name="CloseButton" Classes="window-control close" ToolTip.Tip="{DynamicResource Window.Close}" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Image Source="{DynamicResource CloseButtonImage}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Middle row: Navigation Bar -->
        <Grid Grid.Row="1" Name="NavigationBarRow" Background="{StaticResource PurpleGradient}" Height="36">
            <controls:NavigationBar Name="NavigationBar" />
        </Grid>

        <!-- Bottom row: WebView container (browser view is placed here directly, like SuperLite) -->
        <Grid Grid.Row="2" Background="#FFFFFF" Name="WebViewContainer">
        </Grid>
    </Grid>
</UserControl>
