<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages="using:VetaleBrowser.VetaleBrowser.UI.Pages"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="550"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.HistoryPage"
             Background="#FAFAFA">

    <UserControl.Styles>
        <!-- Сучасний стиль як в Chrome/Edge -->
        <Style Selector="Border.history-item">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
        <Style Selector="Border.history-item:pointerover">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>
        
        <!-- Кнопка Clear All - червоний акцент -->
        <Style Selector="Button#PART_ClearAllButton">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button#PART_ClearAllButton:pointerover">
            <Setter Property="Background" Value="#C82333"/>
        </Style>
        
        <!-- Кнопки фільтрів - pills стиль -->
        <Style Selector="Button.filter-button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style Selector="Button.filter-button:pointerover">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
        <Style Selector="Button.filter-button:pressed">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>
        <Style Selector="Button.filter-button.active">
            <Setter Property="Background" Value="#1A73E8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Пошукове поле -->
        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="TextBox.search-box:focus">
            <Setter Property="BorderBrush" Value="#1A73E8"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="24,24,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                <TextBlock Text="🕒" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource History.Header}" 
                           FontSize="24" 
                           FontWeight="SemiBold" 
                           Foreground="#202124"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Name="PART_ClearAllButton"
                        FontSize="13"
                        Padding="16,10"
                        Click="ClearAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="🗑️" FontSize="14"/>
                        <TextBlock Text="{DynamicResource Common.ClearAll}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search Box -->
        <Border Grid.Row="1" 
                Margin="24,0,24,16"
                Background="White"
                BorderBrush="#DADCE0"
                BorderThickness="1"
                CornerRadius="24"
                Padding="4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="🔍" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="12,0,8,0"
                           Opacity="0.6"/>
                <TextBox Name="PART_SearchBox"
                         Grid.Column="1"
                         Watermark="{DynamicResource History.Search.Watermark}"
                         FontSize="14"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0,12"
                         TextChanged="SearchBox_TextChanged"/>
            </Grid>
        </Border>

        <!-- Time Period Filters -->
        <ScrollViewer Grid.Row="2" 
                     Margin="24,0,24,16"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Disabled">
            <StackPanel Name="PART_FilterPanel" 
                       Orientation="Horizontal"
                       Spacing="8">
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.All}" 
                        Tag="All"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.1Day}" 
                        Tag="1Day"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.7Days}" 
                        Tag="7Days"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.1Month}" 
                        Tag="1Month"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.6Months}" 
                        Tag="6Months"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.1Year}" 
                        Tag="1Year"
                        Click="FilterButton_Click"/>
                <Button Classes="filter-button" 
                        Content="{DynamicResource History.Filter.OlderThanYear}" 
                        Tag="OlderThanYear"
                        Click="FilterButton_Click"/>
            </StackPanel>
        </ScrollViewer>

        <!-- History List with Empty State -->
        <Grid Grid.Row="3" Margin="24,0,24,20">
            <!-- Empty State Panel -->
            <Border Name="PART_EmptyState" 
                    IsVisible="False"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="📭" 
                               FontSize="48" 
                               HorizontalAlignment="Center"
                               Opacity="0.5"/>
                    <TextBlock Text="No browsing history" 
                               FontSize="18" 
                               Foreground="#5F6368"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Your browsing history will appear here" 
                               FontSize="14" 
                               Foreground="#9AA0A6"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- History Items -->
            <ScrollViewer>
                <ItemsControl Name="PART_HistoryItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="pages:HistoryItemViewModel">
                            <Border Classes="history-item" Cursor="Hand">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Favicon -->
                                    <Panel Grid.Column="0"
                                       Width="32"
                                       Height="32"
                                       Margin="0,0,14,0"
                                       VerticalAlignment="Center">
                                    <!-- Background placeholder -->
                                    <Border Width="32"
                                            Height="32"
                                            CornerRadius="4"
                                            Background="#E8EAED"/>
                                    <!-- Favicon image -->
                                    <Image Width="20"
                                           Height="20"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Source="{Binding FaviconImage}"/>
                                </Panel>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="14" 
                                               FontWeight="Normal"
                                               Foreground="#202124"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Url}" 
                                                   FontSize="12" 
                                                   Foreground="#5F6368"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="400"/>
                                        <TextBlock FontSize="12" Foreground="#9AA0A6">
                                            <Run Text="•"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#5F6368"
                                                   Text="{Binding VisitedAt, StringFormat='{}{0:dd MMM yyyy, HH:mm}'}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" 
                                           Orientation="Horizontal" 
                                           Spacing="4"
                                           VerticalAlignment="Center">
                                    <Button Classes="action-button"
                                            Tag="{Binding}"
                                            ToolTip.Tip="{DynamicResource Common.Open}"
                                            Click="OpenHistory_Click">
                                        <TextBlock Text="↗️" FontSize="14"/>
                                    </Button>
                                    <Button Classes="action-button"
                                            Tag="{Binding}"
                                            ToolTip.Tip="{DynamicResource Common.Delete}"
                                            Click="DeleteHistory_Click">
                                        <TextBlock Text="✕" FontSize="12" Foreground="#5F6368"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
