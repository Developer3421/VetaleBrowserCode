<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
              x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.SearchEngineSettingsPage"
              Background="#F3E8FF">

    <UserControl.Styles>
        <Style Selector="RadioButton.search-engine">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="RadioButton.search-engine:pointerover">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
        </Style>
        <Style Selector="RadioButton.search-engine:checked">
            <Setter Property="Background" Value="#E8D4FF"/>
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.back-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.back-button:pointerover">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="TextBox.custom-url">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.custom-url:focus">
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.save-button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style Selector="Button.save-button:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
            <Setter Property="BorderBrush" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.save-button:pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
        </Style>
        
        <!-- Lite panel for buttons -->
        <Style Selector="Border.button-panel">
            <Setter Property="Background" Value="#F3E8FF"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>

        <!-- Lite white button -->
        <Style Selector="Button.vetale-search-button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style Selector="Button.vetale-search-button:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
        </Style>
        <Style Selector="Button.vetale-search-button:pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
        </Style>
        <Style Selector="Button.vetale-search-button:pressed">
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="30" MaxWidth="600">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header with back button -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
                <Button Classes="back-button" Click="OnBackClick">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="←" FontSize="14" Foreground="#505050"/>
                        <TextBlock Text="{DynamicResource Common.Back}" FontSize="14" Foreground="#505050"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{DynamicResource Settings.Search.Title}" FontSize="24" FontWeight="Bold" Foreground="#303030" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Search engine options -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="0">
                    <TextBlock Text="{DynamicResource Settings.Search.Sub}" 
                               FontSize="13" 
                               Foreground="#606060" 
                               Margin="0,0,0,15"/>
                    
                    <!-- Vetale Search (Локальний пошук) як елемент списку -->
                    <RadioButton x:Name="VetaleRadio"
                                 Classes="search-engine"
                                 GroupName="SearchEngine"
                                 Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="🔍" FontSize="20" VerticalAlignment="Center"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Vetale Search"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#9C27B0"/>
                                    <TextBlock Text="{DynamicResource Settings.Search.VetaleSearch.Subtitle}"
                                               FontSize="12"
                                               Foreground="#606060"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Search.VetaleSearch.Description}"
                                       FontSize="12"
                                       Foreground="#505050"
                                       TextWrapping="Wrap"
                                       LineHeight="18"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="{DynamicResource Settings.Search.OnlineEngines}" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Foreground="#303030" 
                               Margin="0,15,0,15"/>

                    <!-- Engines: proper names & sample URLs left literal -->
                    <RadioButton x:Name="GoogleRadio" 
                                 Classes="search-engine" 
                                 GroupName="SearchEngine"
                                 Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Google" FontSize="15" FontWeight="SemiBold" Foreground="#202020"/>
                            <TextBlock Text="https://www.google.com/search?q={0}" FontSize="11" Foreground="#707070"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BingRadio" 
                                 Classes="search-engine" 
                                 GroupName="SearchEngine"
                                 Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Bing" FontSize="15" FontWeight="SemiBold" Foreground="#202020"/>
                            <TextBlock Text="https://www.bing.com/search?q={0}" FontSize="11" Foreground="#707070"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="YahooRadio" 
                                 Classes="search-engine" 
                                 GroupName="SearchEngine"
                                 Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Yahoo" FontSize="15" FontWeight="SemiBold" Foreground="#202020"/>
                            <TextBlock Text="https://search.yahoo.com/search?p={0}" FontSize="11" Foreground="#707070"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="BaiduRadio" 
                                 Classes="search-engine" 
                                 GroupName="SearchEngine"
                                 Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="3">
                            <TextBlock Text="Baidu" FontSize="15" FontWeight="SemiBold" Foreground="#202020"/>
                            <TextBlock Text="https://www.baidu.com/s?wd={0}" FontSize="11" Foreground="#707070"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="CustomRadio" 
                                  Classes="search-engine" 
                                  GroupName="SearchEngine"
                                  Click="OnSearchEngineChanged">
                        <StackPanel Orientation="Vertical" Spacing="8">
                            <TextBlock Text="{DynamicResource Search.Custom.Title}" FontSize="15" FontWeight="SemiBold" Foreground="#202020"/>
                            <TextBlock Text="{DynamicResource Search.Custom.Hint}" 
                                       FontSize="11" 
                                       Foreground="#707070" 
                                       TextWrapping="Wrap"/>
                            <TextBox x:Name="CustomNameTextBox"
                                     Classes="custom-url"
                                     Watermark="Назва, наприклад Мій пошук"
                                     IsEnabled="False"
                                     TextChanged="OnCustomUrlChanged"/>
                            <TextBox x:Name="CustomUrlTextBox" 
                                     Classes="custom-url"
                                     Watermark="https://www.ecosia.org/search?q=  або https://example.com/search?q={0}"
                                     IsEnabled="False"
                                     TextChanged="OnCustomUrlChanged"/>
                            <TextBlock x:Name="CustomErrorText"
                                       FontSize="12"
                                       Foreground="#C62828"
                                       TextWrapping="Wrap"
                                       IsVisible="False"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- Save button -->
            <Border Grid.Row="2" 
                    Classes="button-panel"
                    Padding="15,12"
                    Margin="0,20,0,0">
                <Button Classes="save-button" 
                        Click="OnSaveClick"
                        HorizontalAlignment="Right"
                        Content="{DynamicResource Common.Save}"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
