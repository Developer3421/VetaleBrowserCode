<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:VetaleBrowser.VetaleBrowser.Search.Models"
             xmlns:pages="clr-namespace:VetaleBrowser.VetaleBrowser.UI.Pages"
             xmlns:controls="clr-namespace:VetaleBrowser.VetaleBrowser.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.VetaleSearchResultsPage"
             Background="#F5F5F7">

    <UserControl.Styles>
        <!-- Верхній градієнт як на домашній сторінці -->
        <Style Selector="Border.results-gradient-header">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Витончена картка для основного контенту з градієнтним бордером -->
        <Style Selector="Border.results-card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BoxShadow" Value="0 8 32 #40000000"/>
        </Style>

        <!-- Внутрішня картка: фон керується налаштуваннями -->
        <Style Selector="Border.results-inner-card">
            <Setter Property="Background" Value="{DynamicResource VetaleSearch.Theme.CardBackground}"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- Стилі зі старої версії, адаптовані під нову кольорову схему -->
        <!-- Stats text -->
        <Style Selector="TextBlock.search-stats">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8B4513"/>
            <Setter Property="Margin" Value="0,4,0,20"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Result item - картковий стиль з бежевим фоном -->
        <Style Selector="Border.result-item">
            <Setter Property="Background" Value="{DynamicResource VetaleSearch.Theme.CardBackground}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BoxShadow" Value="0 2 12 #30FF8A00"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Border.result-item:pointerover">
            <Setter Property="BoxShadow" Value="0 6 20 #50FF8A00"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>

        <!-- Спеціальний стиль для прямого URL результату -->
        <Style Selector="Border.result-item-direct">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%" Opacity="0.15">
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BoxShadow" Value="0 4 20 #40FF8A00"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientStart}" Offset="0"/>
                        <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientEnd}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>

        <Style Selector="Border.result-item-direct:pointerover">
            <Setter Property="BoxShadow" Value="0 8 28 #60FF8A00"/>
            <Setter Property="BorderThickness" Value="4"/>
        </Style>

        <!-- Breadcrumb -->
        <Style Selector="TextBlock.breadcrumb-text">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#8B4513"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <Style Selector="TextBlock.breadcrumb-sep">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#CD853F"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Title з градієнтним ефектом -->
        <Style Selector="TextBlock.result-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource VetaleSearch.Theme.LinkColor}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.result-title:pointerover">
            <Setter Property="TextDecorations" Value="Underline"/>
            <Setter Property="Foreground" Value="{DynamicResource VetaleSearch.Theme.GradientStart}"/>
        </Style>

        <!-- Description -->
        <Style Selector="TextBlock.result-description">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
        </Style>

        <!-- Highlighted terms -->
        <Style Selector="Run.highlight">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Pagination -->
        <Style Selector="Button.page-number">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#1A0DAB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinWidth" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.page-number:pointerover">
            <Setter Property="Background" Value="#F1F3F4"/>
        </Style>

        <Style Selector="Button.page-number.active">
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="Button.page-nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="8,0"/>
            <Setter Property="Foreground" Value="#1A0DAB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.page-nav:pointerover">
            <Setter Property="Background" Value="#F1F3F4"/>
        </Style>

        <!-- Related searches -->
        <Style Selector="TextBlock.related-title">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.related-query">
            <Setter Property="Background" Value="#F1F3F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Foreground" Value="#202124"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.related-query:pointerover">
            <Setter Property="Background" Value="#E8EAED"/>
        </Style>

        <!-- Date -->
        <Style Selector="TextBlock.result-date">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#70757A"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Rating -->
        <Style Selector="TextBlock.star">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#FBBC04"/>
        </Style>

        <Style Selector="TextBlock.rating-count">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#70757A"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- Стилі для випадаючого списку підказок -->
        <Style Selector="Border.suggestion-popup">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="BoxShadow" Value="0 8 24 #40000000"/>
            <Setter Property="MaxHeight" Value="400"/>
        </Style>

        <Style Selector="Border.suggestion-popup-inner">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style Selector="Border.suggestion-item">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.suggestion-item:pointerover">
            <Setter Property="Background" Value="Beige"/>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FFAA00" Offset="0"/>
                        <GradientStop Color="#B040C0" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BoxShadow" Value="0 2 8 #30FF8A00"/>
        </Style>

        <Style Selector="TextBlock.suggestion-text">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.suggestion-icon">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Header search input -->
        <Style Selector="TextBox.search-input">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.search-input:focus">
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Header icon buttons -->
        <Style Selector="Button.icon-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="CornerRadius" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.icon-button:pointerover">
            <Setter Property="Background" Value="#0D000000"/>
        </Style>
    </UserControl.Styles>

    <!-- Основний макет: градієнтна шапка + картка результатів -->
    <Grid RowDefinitions="Auto,*">
        <!-- Шапка з градієнтом і пошуком на всю ширину -->
        <Border Grid.Row="0" Classes="results-gradient-header" Padding="16,12">
            <Grid ColumnDefinitions="Auto,*" HorizontalAlignment="Stretch">
                <!-- Логотип/назва, притиснутий до лівого краю -->
                <StackPanel Grid.Column="0"
                            Orientation="Vertical"
                            Spacing="0"
                            Margin="24,0,24,0"
                            HorizontalAlignment="Left">
                    <TextBlock Text="{DynamicResource VetaleSearch.Logo.Vetale}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{DynamicResource VetaleSearch.Logo.Search}" FontSize="14" Foreground="White" Opacity="0.9"/>
                </StackPanel>

                <!-- Пошуковий рядок + всі кнопки в одному рядку, розтягнутий на всю ширину -->
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="0,0,24,0" HorizontalAlignment="Stretch">
                    <!-- Поле пошуку з підказками -->
                    <Grid Grid.Column="0">
                        <Border Background="White"
                                CornerRadius="24"
                                Padding="0"
                                BoxShadow="0 4 16 #26000000"
                                HorizontalAlignment="Stretch">
                            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                <TextBox x:Name="SearchInput"
                                         Grid.Column="0"
                                         Classes="search-input"
                                         Watermark="{DynamicResource VetaleSearch.SearchWatermark}"
                                         KeyDown="SearchInput_KeyDown"
                                         TextChanged="SearchInput_TextChanged"
                                         TextWrapping="NoWrap"
                                         MaxLength="256"/>

                                <!-- Всі інструменти пошуку в одному ряду -->
                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="4"
                                            Margin="0,0,8,0">
                                    <Button Classes="icon-button" ToolTip.Tip="{DynamicResource VetaleSearch.VideoSearch}" Click="VideoSearchButton_Click">
                                        <TextBlock Text="📹" FontSize="18"/>
                                    </Button>
                                    <Button Classes="icon-button" ToolTip.Tip="{DynamicResource VetaleSearch.GeoSearch}" Click="GeoSearch_Click">
                                        <TextBlock Text="📍" FontSize="18"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Popup з підказками -->
                        <Popup x:Name="SuggestionsPopup"
                               Placement="Bottom"
                               PlacementTarget="{Binding #SearchInput}"
                               IsLightDismissEnabled="True"
                               IsOpen="False"
                               MaxWidth="600">
                            <Border Classes="suggestion-popup">
                                <Border Classes="suggestion-popup-inner">
                                    <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="SuggestionsListBox">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:SearchSuggestion">
                                                    <Border Classes="suggestion-item"
                                                            PointerPressed="SuggestionItem_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Classes="suggestion-icon"
                                                                       Text="{Binding Icon}"/>
                                                            <TextBlock Classes="suggestion-text"
                                                                       Text="{Binding Text}"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Основна кнопка пошуку справа, без напису "Пошук" -->
                    <Button Grid.Column="1"
                            x:Name="SearchButton"
                            Click="Search_Click"
                            IsDefault="True"
                            Padding="20,10"
                            Margin="8,0,0,0"
                            HorizontalAlignment="Right">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientStart}" Offset="0"/>
                                <GradientStop Color="{DynamicResource VetaleSearch.Theme.GradientEnd}" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Foreground>White</Button.Foreground>
                        <Button.CornerRadius>24</Button.CornerRadius>
                        <TextBlock Text="🔍" FontSize="18"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Зона результатів - розділена на дві частини -->
        <Grid Grid.Row="1" ColumnDefinitions="*,380">
            <!-- Ліва колонка: прокручувані результати -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,16,0,24">
                    <!-- Основний контент -->
                    <Border Classes="results-card" Margin="32,0,16,0" HorizontalAlignment="Stretch" MaxWidth="900">
                    <Border Classes="results-inner-card">
                        <StackPanel>
                            <!-- Перемикач режимів пошуку -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                <Button x:Name="ModeSitesButton" Classes="page-number active" Click="ModeSites_Click" Content="{DynamicResource Search.Mode.Sites}"/>
                                <Button x:Name="ModeVideosButton" Classes="page-number" Click="ModeVideos_Click" Content="{DynamicResource Search.Mode.Videos}"/>
                            </StackPanel>

                            <TextBlock x:Name="QueryHeading"
                                       Text="{DynamicResource Search.Results.Heading}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#8B4513"
                                       Margin="0,0,0,4"/>
                            <!-- Stats -->
                            <TextBlock x:Name="SearchStats"
                                       Classes="search-stats"
                                       Text="{DynamicResource Search.Results.Prompt}"/>

                            <!-- Results -->
                            <StackPanel x:Name="ResultsPanel" Margin="0,12,0,0">
                            <!-- Result 1 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="https://example.com"/>
                                        <TextBlock Classes="breadcrumb-sep" Text="›"/>
                                        <TextBlock Classes="breadcrumb-text" Text="docs"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Introduction to Web Development - Complete Guide 2025"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-description">
                                        <Run Text="Learn the fundamentals of "/>
                                        <Run Classes="highlight" Text="web development"/>
                                        <Run Text=" with our comprehensive guide covering HTML, CSS, JavaScript and modern frameworks..."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Result 2 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="www.techblog.org"/>
                                        <TextBlock Classes="breadcrumb-sep" Text="›"/>
                                        <TextBlock Classes="breadcrumb-text" Text="articles"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Modern JavaScript: Essential Concepts Every Developer Should Know"
                                               PointerPressed="ResultTitle_Click"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/>
                                        <TextBlock Classes="rating-count" Text="4.8 · 234 відгуки"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-description" 
                                               Text="Explore advanced JavaScript patterns including async/await, promises, closures, and prototypal inheritance..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 3 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="devnews.io"/>
                                        <TextBlock Classes="breadcrumb-sep" Text="›"/>
                                        <TextBlock Classes="breadcrumb-text" Text="2025"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Top 10 Frontend Frameworks in 2025"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-date" Text="15 січ. 2025"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Comprehensive comparison of the most popular frontend frameworks including React, Vue, Angular, and Svelte..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 4 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="programming-tutorials.net"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Complete Python Programming Course: From Beginner to Advanced"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Master Python programming with 50+ hours of video content, hands-on projects, and coding exercises..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 5 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="docs.framework.dev"/>
                                        <TextBlock Classes="breadcrumb-sep" Text="›"/>
                                        <TextBlock Classes="breadcrumb-text" Text="api"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="API Reference Documentation - Complete Developer Guide"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-date" Text="8 лист. 2024"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Official API documentation with detailed endpoint descriptions, authentication methods, and code examples..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 6 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="webdesign.academy"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Responsive Web Design: Best Practices 2025"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Learn how to create responsive websites that work perfectly on all devices using modern CSS techniques..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 7 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="stackoverflow.blog"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Developer Survey Results 2025: Trends and Insights"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-date" Text="22 верес. 2024"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Analysis of responses from over 90,000 developers worldwide about languages, frameworks, and tools..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 8 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="github.com"/>
                                        <TextBlock Classes="breadcrumb-sep" Text="›"/>
                                        <TextBlock Classes="breadcrumb-text" Text="awesome-lists"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="Awesome Web Development Resources - Curated List"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-description" 
                                               Text="A carefully curated collection of the best web development resources, tools, libraries and learning materials..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 9 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="css-tricks.com"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="A Complete Guide to CSS Flexbox and Grid Layouts"
                                               PointerPressed="ResultTitle_Click"/>
                                    <TextBlock Classes="result-description" 
                                               Text="Visual guide to modern CSS layout systems with detailed explanations and interactive examples..."/>
                                </StackPanel>
                            </Border>

                            <!-- Result 10 -->
                            <Border Classes="result-item">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Classes="breadcrumb-text" Text="mdn.webdocs.mozilla.org"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-title" 
                                               Text="MDN Web Docs - Resources for Developers"
                                               PointerPressed="ResultTitle_Click"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/><TextBlock Classes="star" Text="★"/>
                                        <TextBlock Classes="rating-count" Text="4.9 · 15K відгуків"/>
                                    </StackPanel>
                                    <TextBlock Classes="result-description" 
                                               Text="The most comprehensive source of web technology documentation covering HTML, CSS, JavaScript, and Web APIs..."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Related searches section -->
                        <StackPanel x:Name="RelatedSection" Margin="0,20,0,0" IsVisible="False">
                            <TextBlock Classes="related-title" Text="{DynamicResource Search.Related.Title}"/>
                            <ItemsControl x:Name="RelatedQueriesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Classes="related-query"
                                                Click="RelatedQuery_Click"
                                                Content="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- end Related searches section -->
                        
                        <!-- Video Results Container -->
                        <StackPanel x:Name="VideoResultsHost" IsVisible="False" Margin="0,12,0,0">
                            <controls:VideoSearchResultsView x:Name="VideoResultsView"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Border>
                </Grid>
            </ScrollViewer>

            <!-- Права колонка: Perplexity AI Chat (фіксована, не прокручується з результатами) -->
            <Border Grid.Column="1" 
                    x:Name="DuckDuckGoChatContainer" 
                    Background="White" 
                    CornerRadius="20" 
                    Padding="0" 
                    Margin="0,16,32,24"
                    BoxShadow="0 4 16 #14000000"
                    IsVisible="True">
                <pages:DuckDuckGoAiChatPanel x:Name="DuckDuckGoChat"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
