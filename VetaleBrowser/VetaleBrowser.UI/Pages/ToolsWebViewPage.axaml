<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.ToolsWebViewPage"
             Background="#FF9800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with back button and title -->
        <Border Grid.Row="0" 
                Background="#F8F8F8" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,0,0,1"
                Padding="15,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Back button -->
                <Button Grid.Column="0" 
                        x:Name="BackButton"
                        Click="OnBackClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Cursor="Hand"
                        ToolTip.Tip="{DynamicResource Tools.BackToList}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="←" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Common.Back}" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Tool name -->
                <TextBlock Grid.Column="1"
                           x:Name="ToolNameText"
                           Text="{DynamicResource Tools.ToolTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#303030"/>

                <!-- Refresh button -->
                <Button Grid.Column="2"
                        x:Name="RefreshButton"
                        Click="OnRefreshClick"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="8"
                        Cursor="Hand"
                        ToolTip.Tip="{DynamicResource Common.Refresh}">
                    <TextBlock Text="🔄" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- WebView Container -->
        <Grid Grid.Row="1" 
              x:Name="WebViewContainer"
              Background="#FFFFFF">
            <TextBlock Text="{DynamicResource Common.Loading}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#808080"
                       FontSize="16"/>
        </Grid>
    </Grid>
</UserControl>
