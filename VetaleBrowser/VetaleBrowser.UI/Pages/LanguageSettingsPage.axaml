<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.LanguageSettingsPage"
             Background="#FF9800">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#2E7D32"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#1B5E20"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#388E3C"/>
      <Setter Property="BorderBrush" Value="#2E7D32"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#1B5E20"/>
    </Style>
    <Style Selector="Border.button-panel">
      <Setter Property="Background" Value="#FF9800"/>
      <Setter Property="BorderBrush" Value="#F57C00"/>
      <Setter Property="BorderThickness" Value="0,1,0,0"/>
    </Style>
  </UserControl.Styles>
  
  <Grid Margin="30" RowDefinitions="Auto,Auto,*,Auto" MaxWidth="600">
    <TextBlock Grid.Row="0" Text="{DynamicResource Language.Header}" FontSize="28" FontWeight="Bold" Foreground="#303030" Margin="0,0,0,20"/>

    <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="8">
      <TextBlock Text="{DynamicResource Language.SelectPrompt}" FontSize="14" Foreground="#404040"/>
      <!-- Use DisplayMemberBinding instead of ItemTemplate to avoid XAML binding issues -->
      <ComboBox x:Name="LanguageCombo" Width="300" MaxDropDownHeight="300"/>
      <TextBlock Text="{DynamicResource Language.RestartHint}" FontSize="12" Foreground="#707070"/>
    </StackPanel>

    <Border Grid.Row="3" Classes="button-panel" Padding="15,12" Margin="-30,20,-30,-30">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button x:Name="BackButton" Content="{DynamicResource Common.Back}" Width="120" Click="OnBack"/>
        <Button x:Name="SaveButton" Content="{DynamicResource Common.Save}" Width="140" Click="OnSave"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>

