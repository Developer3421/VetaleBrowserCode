<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.TabAppearanceSettingsPage"
             Background="#FF9800">

    <UserControl.Styles>
        <Style Selector="Button.back-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.back-button:pointerover">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="TextBox.setting-input">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Width" Value="120"/>
        </Style>
        <Style Selector="TextBox.setting-input:focus">
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.save-button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.save-button:pointerover">
            <Setter Property="Background" Value="#388E3C"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <Style Selector="Button.save-button:pressed">
            <Setter Property="Background" Value="#1B5E20"/>
        </Style>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        
        <!-- Оранжевий фон для панелі кнопок -->
        <Style Selector="Border.button-panel">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="BorderBrush" Value="#F57C00"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Button Name="BackButton"
                    Classes="back-button"
                    Click="OnBackClick"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="←" FontSize="16"/>
                    <TextBlock Text="{DynamicResource Common.Back}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource Appearance.Tabs.Header}"
                      FontSize="24"
                      FontWeight="Bold"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                
                <!-- Tab Width -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.Width}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.Tabs.WidthPx}"/>
                            <TextBox Name="TabWidthTextBox" 
                                    Classes="setting-input"
                                    Watermark="200"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab Element Size -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.ElementsSize}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.Tabs.TextSizePx}"/>
                            <TextBox Name="TabElementSizeTextBox" 
                                    Classes="setting-input"
                                    Watermark="16"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab Icon Size -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.IconSize}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.Tabs.IconSizePx}"/>
                            <TextBox Name="TabIconSizeTextBox" 
                                    Classes="setting-input"
                                    Watermark="16"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab Background Color -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.BackgroundColor}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.ColorHex}"/>
                            <TextBox Name="TabBackgroundColorTextBox" 
                                    Classes="setting-input"
                                    Watermark="#F5F5F5"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab Text Color -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.TextColor}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.ColorHex}"/>
                            <TextBox Name="TabTextColorTextBox" 
                                    Classes="setting-input"
                                    Watermark="#000000"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Tab Active Color -->
                <Border Background="#F5F5F5" 
                        BorderBrush="#CCCCCC" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{DynamicResource Appearance.Tabs.ActiveColor}" FontWeight="SemiBold" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource Appearance.ColorHex}"/>
                            <TextBox Name="TabActiveColorTextBox" 
                                    Classes="setting-input"
                                    Watermark="#9A1CE8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Classes="button-panel"
                Padding="15,12"
                Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Spacing="10">
                <Button Name="ResetButton"
                        Background="#FF6B6B"
                        Foreground="White"
                        BorderThickness="0"
                        Padding="20,10"
                        FontSize="14"
                        Cursor="Hand"
                        CornerRadius="4"
                        Click="OnResetClick">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="#FF4757"/>
                        </Style>
                    </Button.Styles>
                    <!-- Use Content attribute with DynamicResource so localized string is resolved correctly -->
                    <Button.Content>
                        <TextBlock Text="{DynamicResource Common.ResetDefaults}"/>
                    </Button.Content>
                </Button>
                <Button Name="SaveButton"
                        Classes="save-button"
                        Click="OnSaveClick">
                    <!-- Use Content attribute with DynamicResource so localized string is resolved correctly -->
                    <Button.Content>
                        <TextBlock Text="{DynamicResource Appearance.SaveSettings}"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
