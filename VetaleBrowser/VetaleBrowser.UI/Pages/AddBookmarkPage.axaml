<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.AddBookmarkPage"
             Background="#FAFAFA">

    <UserControl.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="Button.action-button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cancel-button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.cancel-button:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
            <Setter Property="BorderBrush" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.cancel-button:pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
        </Style>

        <Style Selector="Button.save-button">
            <Setter Property="Background" Value="#9A1CE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.save-button:pointerover">
            <Setter Property="Background" Value="#8612D0"/>
        </Style>
        <Style Selector="Button.save-button:pressed">
            <Setter Property="Background" Value="#7C1FD6"/>
        </Style>
        
        <!-- Світла панель кнопок -->
        <Style Selector="Border.button-panel">
            <Setter Property="Background" Value="#F3E8FF"/>
            <Setter Property="BorderBrush" Value="#A78BFA"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="40,30" MaxWidth="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="8">
            <TextBlock Text="⭐" FontSize="32" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Bookmarks.Add.Header}" 
                       FontSize="20" 
                       FontWeight="SemiBold" 
                       Foreground="#303030"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Name Label -->
        <TextBlock Grid.Row="2" 
                   Text="{DynamicResource Bookmarks.Add.Name}" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   
                   Margin="0,0,0,6"/>
        

        <!-- Name TextBox -->
        <TextBox Grid.Row="3" 
                 Name="PART_NameTextBox"
                 Watermark="{DynamicResource Bookmarks.Add.Name.Watermark}"/>

        <!-- URL Label -->
        <TextBlock Grid.Row="5" 
                   Text="URL:" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,6"/>

        <!-- URL TextBox -->
        <TextBox Grid.Row="6" 
                 Name="PART_UrlTextBox"
                 Watermark="https://example.com"
                 IsReadOnly="True"/>

        <!-- Folder Label -->
        <TextBlock Grid.Row="8" 
                   Text="{DynamicResource Bookmarks.Add.Folder}" 
                   FontSize="13" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,6"/>

        <!-- Folder ComboBox -->
        <ComboBox Grid.Row="9" 
                  Name="PART_FolderComboBox"
                  SelectedIndex="0"
                  HorizontalAlignment="Stretch">
            <ComboBoxItem Content="{DynamicResource Bookmarks.Folder.Default}"/>
            <ComboBoxItem Content="{DynamicResource Bookmarks.Folder.Work}"/>
            <ComboBoxItem Content="{DynamicResource Bookmarks.Folder.Personal}"/>
            <ComboBoxItem Content="{DynamicResource Bookmarks.Folder.News}"/>
        </ComboBox>

        <!-- Buttons -->
        <Border Grid.Row="11" 
                Classes="button-panel"
                Padding="15,12"
                Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right"
                        Spacing="10">
                <Button Name="PART_CancelButton"
                        Content="{DynamicResource Common.Cancel}" 
                        Width="110"
                        Classes="action-button cancel-button"
                        Click="CancelButton_Click"/>

                <Button Name="PART_SaveButton"
                        Content="{DynamicResource Common.Save}" 
                        Width="110"
                        Classes="action-button save-button"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
