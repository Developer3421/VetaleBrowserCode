<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:VetaleBrowser.VetaleBrowser.Database.Models;assembly=VetaleBrowser"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.BookmarksPage"
             Background="#FAFAFA">

    <UserControl.Styles>
        <Style Selector="Border.bookmark-item">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style Selector="Border.bookmark-item:pointerover">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#DADCE0"/>
        </Style>
        <Style Selector="Button.action-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.action-button:pointerover">
            <Setter Property="Background" Value="#E8E8E8"/>
        </Style>
        
        <!-- Головна кнопка додавання - фіолетовий акцент -->
        <Style Selector="Button#PART_AddBookmarkButton">
            <Setter Property="Background" Value="#9A1CE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button#PART_AddBookmarkButton:pointerover">
            <Setter Property="Background" Value="#8612D0"/>
        </Style>
        
        <!-- Кнопки фільтрів - нейтральні pills як в історії -->
        <Style Selector="Button:not(.action-button):not(#PART_AddBookmarkButton)">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style Selector="Button:not(.action-button):not(#PART_AddBookmarkButton):pointerover">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>
        <Style Selector="Button:not(.action-button):not(#PART_AddBookmarkButton):pressed">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,30,30,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="{DynamicResource Bookmarks.Header}" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#303030"/>

            <Button Grid.Column="1"
                    Name="PART_AddBookmarkButton"
                    Background="#9A1CE8"
                    Foreground="White"
                    FontSize="14"
                    Padding="15,10"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="AddBookmark_Click">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="#8612D0"/>
                    </Style>
                </Button.Styles>
                <TextBlock>
                    <Run Text="+ "/>
                    <Run Text="{DynamicResource Bookmarks.Add}"/>
                </TextBlock>
            </Button>
        </Grid>

        <!-- Folder Tabs -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="30,0,30,20">
            <Button Name="PART_AllFoldersButton"
                    Content="{DynamicResource Common.All}"
                    Tag=""
                    Padding="15,8"
                    Margin="0,0,10,0"
                    Background="#9A1CE8"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="FolderFilter_Click"/>
            <Button Content="{DynamicResource Bookmarks.Folder.Default}"
                    Tag="{DynamicResource Bookmarks.Folder.Default}"
                    Padding="15,8"
                    Margin="0,0,10,0"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="FolderFilter_Click"/>
            <Button Content="{DynamicResource Bookmarks.Folder.Work}"
                    Tag="{DynamicResource Bookmarks.Folder.Work}"
                    Padding="15,8"
                    Margin="0,0,10,0"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="FolderFilter_Click"/>
            <Button Content="{DynamicResource Bookmarks.Folder.Personal}"
                    Tag="{DynamicResource Bookmarks.Folder.Personal}"
                    Padding="15,8"
                    Margin="0,0,10,0"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="FolderFilter_Click"/>
            <Button Content="{DynamicResource Bookmarks.Folder.News}"
                    Tag="{DynamicResource Bookmarks.Folder.News}"
                    Padding="15,8"
                    Background="#E0E0E0"
                    Foreground="#333333"
                    BorderThickness="0"
                    CornerRadius="4"
                    Click="FolderFilter_Click"/>
        </StackPanel>

        <!-- Bookmarks List -->
        <ScrollViewer Grid.Row="2" Margin="30,0,30,30">
            <ItemsControl Name="PART_BookmarksItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Bookmark">
                        <Border Classes="bookmark-item">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Favicon -->
                                <Border Grid.Column="0" 
                                        Width="32" 
                                        Height="32" 
                                        Background="#9A1CE8"
                                        CornerRadius="4"
                                        Margin="0,0,15,0">
                                    <TextBlock Text="⭐" 
                                               FontSize="18" 
                                               Foreground="White"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold"
                                               Foreground="#202020"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Url}" 
                                               FontSize="12" 
                                               Foreground="#606060"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0"/>
                                    <TextBlock Text="{Binding Folder}" 
                                               FontSize="11" 
                                               Foreground="#9A1CE8"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <!-- Actions -->
                                <StackPanel Grid.Column="2" 
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Classes="action-button"
                                            Content="🌐"
                                            FontSize="18"
                                            ToolTip.Tip="{DynamicResource Common.Open}"
                                            Tag="{Binding}"
                                            Click="OpenBookmark_Click"/>
                                    <Button Classes="action-button"
                                            Content="🗑️"
                                            FontSize="18"
                                            ToolTip.Tip="{DynamicResource Common.Delete}"
                                            Tag="{Binding}"
                                            Click="DeleteBookmark_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
