<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
              x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.SettingsMainPage"
              Background="#F3E8FF">

    <UserControl.Styles>
        <Style Selector="Button.settings-button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.settings-button:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
            <Setter Property="BorderBrush" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.settings-button:pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
            <Setter Property="BorderBrush" Value="#FF7C3AED"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="30" MaxWidth="600">
        <StackPanel Spacing="0">
            <TextBlock Text="{DynamicResource Settings.Header}" FontSize="28" FontWeight="Bold" Foreground="#303030" Margin="0,0,0,30"/>
            
            <Button Classes="settings-button" Click="OnLanguageClick">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <TextBlock Text="{DynamicResource Settings.Language.Title}" FontSize="16" FontWeight="SemiBold" Foreground="#202020"/>
                    <TextBlock Text="{DynamicResource Settings.Language.Sub}" FontSize="12" Foreground="#606060"/>
                </StackPanel>
            </Button>

            <Button Classes="settings-button" Click="OnAppearanceClick">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <TextBlock Text="{DynamicResource Settings.Appearance.Title}" FontSize="16" FontWeight="SemiBold" Foreground="#202020"/>
                    <TextBlock Text="{DynamicResource Settings.Appearance.Sub}" FontSize="12" Foreground="#606060"/>
                </StackPanel>
            </Button>

            <Button Classes="settings-button" Click="OnSearchEngineClick">
                <StackPanel Orientation="Vertical" Spacing="5">
                    <TextBlock Text="{DynamicResource Settings.Search.Title}" FontSize="16" FontWeight="SemiBold" Foreground="#202020"/>
                    <TextBlock Text="{DynamicResource Settings.Search.Sub}" FontSize="12" Foreground="#606060"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
