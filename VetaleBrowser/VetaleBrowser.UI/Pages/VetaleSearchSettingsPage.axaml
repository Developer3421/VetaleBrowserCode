<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.VetaleSearchSettingsPage"
             Background="#FF9800">

    <UserControl.Styles>
        <Style Selector="Button.back-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style Selector="Button.back-button:pointerover">
            <Setter Property="Background" Value="#15000000"/>
        </Style>
        <Style Selector="TextBox.setting-input">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBox.setting-input:focus">
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="TextBox.api-key-input">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        </Style>
        <Style Selector="TextBox.api-key-input:focus">
            <Setter Property="BorderBrush" Value="#9A1CE8"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>
        <Style Selector="Button.save-button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1B5E20"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.save-button:pointerover">
            <Setter Property="Background" Value="#388E3C"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
        </Style>
        <Style Selector="Button.save-button:pressed">
            <Setter Property="Background" Value="#1B5E20"/>
        </Style>
        <Style Selector="Button.reset-button">
            <Setter Property="Background" Value="#757575"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.reset-button:pointerover">
            <Setter Property="Background" Value="#8D8D8D"/>
        </Style>
        <Style Selector="TextBlock.setting-label">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style Selector="TextBlock.section-header">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#303030"/>
        </Style>
        <Style Selector="Border.button-panel">
            <Setter Property="Background" Value="#FF9800"/>
            <Setter Property="BorderBrush" Value="#F57C00"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
        </Style>
        <Style Selector="Border.api-card">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style Selector="Button.link-button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.link-button:pointerover">
            <Setter Property="Foreground" Value="#1976D2"/>
        </Style>
    </UserControl.Styles>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,20">
            <Button Name="BackButton"
                    Classes="back-button"
                    Click="OnBackClick"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="←" FontSize="16"/>
                    <TextBlock Text="{DynamicResource Common.Back}"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="🔍" FontSize="28"/>
                <TextBlock Text="{DynamicResource VetaleSearch.Settings.Header}"
                          FontSize="24"
                          FontWeight="Bold"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                
                <!-- API Keys Section -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🔑" FontSize="18"/>
                            <TextBlock Classes="section-header" Text="{DynamicResource VetaleSearch.Settings.ApiKeys.Title}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource VetaleSearch.Settings.ApiKeys.Description}" 
                                   FontSize="13" 
                                   Foreground="#606060" 
                                   TextWrapping="Wrap"/>
                        
                        <!-- Pexels API -->
                        <Border Classes="api-card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="📷" FontSize="16"/>
                                    <TextBlock Text="Pexels" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <TextBox x:Name="PexelsApiKeyInput" 
                                         Classes="api-key-input"
                                         Watermark="{DynamicResource VetaleSearch.Settings.Pexels.Watermark}"
                                         PasswordChar="•"/>
                                <Button Classes="link-button" Content="{DynamicResource Pexels.ApiKey.OpenPortal}" Click="OnOpenPexelsPortal"/>
                            </StackPanel>
                        </Border>

                        <!-- Unsplash API -->
                        <Border Classes="api-card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="🖼️" FontSize="16"/>
                                    <TextBlock Text="Unsplash" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <TextBox x:Name="UnsplashApiKeyInput" 
                                         Classes="api-key-input"
                                         Watermark="{DynamicResource VetaleSearch.Settings.Unsplash.Watermark}"
                                         PasswordChar="•"/>
                                <Button Classes="link-button" Content="{DynamicResource Unsplash.ApiKey.OpenPortal}" Click="OnOpenUnsplashPortal"/>
                            </StackPanel>
                        </Border>

                        <!-- YouTube API -->
                        <Border Classes="api-card">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="▶️" FontSize="16"/>
                                    <TextBlock Text="YouTube" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <TextBox x:Name="YouTubeApiKeyInput" 
                                         Classes="api-key-input"
                                         Watermark="{DynamicResource VetaleSearch.Settings.YouTube.Watermark}"
                                         PasswordChar="•"/>
                                <Button Classes="link-button" Content="{DynamicResource YouTube.ApiKey.OpenPortal}" Click="OnOpenYouTubePortal"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Appearance Section -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="🎨" FontSize="18"/>
                            <TextBlock Classes="section-header" Text="{DynamicResource VetaleSearch.Settings.Appearance.Title}"/>
                        </StackPanel>
                        <TextBlock Text="{DynamicResource VetaleSearch.Settings.Appearance.Description}" 
                                   FontSize="13" 
                                   Foreground="#606060" 
                                   TextWrapping="Wrap"/>
                        
                        <!-- Primary Gradient Start Color -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                            <TextBlock Classes="setting-label" Text="{DynamicResource VetaleSearch.Settings.GradientStart}" Width="200"/>
                            <TextBox x:Name="GradientStartColorInput" 
                                     Classes="setting-input"
                                     Width="120"
                                     Watermark="#FF8A00"/>
                            <Border x:Name="GradientStartPreview" Width="30" Height="30" CornerRadius="4" Background="#FF8A00"/>
                        </StackPanel>

                        <!-- Primary Gradient End Color -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource VetaleSearch.Settings.GradientEnd}" Width="200"/>
                            <TextBox x:Name="GradientEndColorInput" 
                                     Classes="setting-input"
                                     Width="120"
                                     Watermark="#9C27B0"/>
                            <Border x:Name="GradientEndPreview" Width="30" Height="30" CornerRadius="4" Background="#9C27B0"/>
                        </StackPanel>

                        <!-- Results Card Background -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource VetaleSearch.Settings.CardBackground}" Width="200"/>
                            <TextBox x:Name="CardBackgroundInput" 
                                     Classes="setting-input"
                                     Width="120"
                                     Watermark="#FFFFFF"/>
                            <Border x:Name="CardBackgroundPreview" Width="30" Height="30" CornerRadius="4" Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1"/>
                        </StackPanel>

                        <!-- Link Color -->
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Classes="setting-label" Text="{DynamicResource VetaleSearch.Settings.LinkColor}" Width="200"/>
                            <TextBox x:Name="LinkColorInput" 
                                     Classes="setting-input"
                                     Width="120"
                                     Watermark="#1565C0"/>
                            <Border x:Name="LinkColorPreview" Width="30" Height="30" CornerRadius="4" Background="#1565C0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Info Note -->
                <Border Background="#E3F2FD" CornerRadius="6" Padding="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="💡" FontSize="18"/>
                        <TextBlock Text="{DynamicResource VetaleSearch.Settings.Note}" 
                                   FontSize="12" 
                                   Foreground="#1565C0" 
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Action Buttons -->
        <Border Grid.Row="2" 
                Classes="button-panel"
                Padding="15,12"
                Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Right" 
                       Spacing="12">
                <Button Classes="reset-button"
                       Content="{DynamicResource Common.ResetDefaults}"
                       Click="OnResetClick"/>
                <Button Classes="save-button"
                       Content="{DynamicResource Appearance.SaveSettings}"
                       Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

