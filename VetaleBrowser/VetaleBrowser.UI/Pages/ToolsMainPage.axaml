<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
              x:Class="VetaleBrowser.VetaleBrowser.UI.Pages.ToolsMainPage"
              Background="#F3E8FF">

    <UserControl.Styles>
        <Style Selector="Border.tool-item">
            <Setter Property="Background" Value="#F8F8F8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style Selector="Border.tool-item:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
            <Setter Property="BorderBrush" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.nav-button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFA78BFA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.nav-button:pointerover">
            <Setter Property="Background" Value="#FFF5F3FF"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
        </Style>
        <Style Selector="Button.nav-button:pressed">
            <Setter Property="Background" Value="#FFEBE4FF"/>
            <Setter Property="Foreground" Value="#FF7C3AED"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="30,30,30,20">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="🛠️" 
                           FontFamily="Segoe UI Emoji, Noto Color Emoji, Apple Color Emoji"
                           FontSize="32" 
                           VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource Tools.Header}" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#303030"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Tools List -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ToolsListPanel" Spacing="0" Margin="30,0,30,30">
                <!-- Tools will be added here programmatically -->
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
