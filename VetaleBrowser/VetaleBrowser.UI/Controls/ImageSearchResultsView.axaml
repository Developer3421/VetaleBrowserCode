<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:VetaleBrowser.VetaleBrowser.Search.Models;assembly=VetaleBrowser"
             xmlns:controls="clr-namespace:VetaleBrowser.VetaleBrowser.UI.Controls"
             mc:Ignorable="d"
             x:Class="VetaleBrowser.VetaleBrowser.UI.Controls.ImageSearchResultsView">
    
    <UserControl.Styles>
        <!-- Професійна картка зображення -->
        <Style Selector="Border.image-card">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BoxShadow" Value="0 2 8 0 #15000000"/>
        </Style>
        <Style Selector="Border.image-card:pointerover">
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BoxShadow" Value="0 4 16 0 #25000000"/>
        </Style>
        
        <!-- Бейдж провайдера -->
        <Style Selector="Border.provider-badge">
            <Setter Property="Background" Value="#E8FFFFFF"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>
        
        <!-- Контейнер зображення -->
        <Style Selector="Border.image-container">
            <Setter Property="CornerRadius" Value="12,12,0,0"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
    </UserControl.Styles>
    
    <Grid>
        <ScrollViewer x:Name="PART_ScrollViewer" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="ItemsHost" Margin="8">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ImageSearchResult">
                        <Border Classes="image-card" Width="220">
                            <Grid RowDefinitions="180,Auto">
                                <!-- Зображення -->
                                <Grid Grid.Row="0">
                                    <Border Classes="image-container" Height="180">
                                        <!-- Використовуємо AsyncImage для оптимізованого завантаження -->
                                        <controls:AsyncImage Source="{Binding ThumbnailUrl}" 
                                                             Stretch="UniformToFill"
                                                             Width="220" Height="180"/>
                                    </Border>
                                    
                                    <!-- Overlay з інформацією -->
                                    <Border CornerRadius="12,12,0,0" VerticalAlignment="Bottom">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#80000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Grid Margin="10,20,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Розмір -->
                                            <TextBlock Grid.Column="0"
                                                       FontSize="11"
                                                       Foreground="White"
                                                       Opacity="0.9"
                                                       VerticalAlignment="Center">
                                                <Run Text="{Binding Width}"/>
                                                <Run Text="×"/>
                                                <Run Text="{Binding Height}"/>
                                            </TextBlock>
                                            
                                            <!-- Провайдер -->
                                            <Border Grid.Column="1" Classes="provider-badge">
                                                <TextBlock Text="{Binding Provider}" 
                                                           FontSize="10" 
                                                           FontWeight="SemiBold"
                                                           Foreground="#333"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                                
                                <!-- Інформація -->
                                <StackPanel Grid.Row="1" Margin="12,10">
                                    <!-- Заголовок -->
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               Foreground="#1A1A1A"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Title}"/>
                                    
                                    <!-- Автор -->
                                    <StackPanel Orientation="Horizontal" 
                                                Spacing="6" 
                                                Margin="0,6,0,0">
                                        <TextBlock Text="📷" FontSize="12"/>
                                        <TextBlock Text="{Binding PhotographerName}" 
                                                   FontSize="12" 
                                                   Foreground="#666666"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="160"/>
                                    </StackPanel>
                                    
                                    <!-- Кольорова лінія -->
                                    <Border Height="3" 
                                            CornerRadius="2"
                                            Margin="0,8,0,0"
                                            Background="#4285F4"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Індикатор завантаження -->
        <Border x:Name="LoadingIndicator" 
                IsVisible="False"
                Background="#80FFFFFF"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                CornerRadius="20"
                Padding="20,10"
                Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="⏳" FontSize="16"/>
                <TextBlock Text="Завантаження зображень..." FontSize="14" Foreground="#333"/>
            </StackPanel>
        </Border>
        
        <!-- Повідомлення коли немає результатів -->
        <Border x:Name="NoResultsMessage"
                IsVisible="False"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16" HorizontalAlignment="Center">
                <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Зображення не знайдено" 
                           FontSize="18" 
                           FontWeight="SemiBold"
                           Foreground="#666"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Спробуйте змінити пошуковий запит"
                           FontSize="14"
                           Foreground="#999"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

