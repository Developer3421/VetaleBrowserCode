  <x:String x:Key="History.Filter.6Months">6 месяцев</x:String>
  <x:String x:Key="History.Filter.1Year">1 год</x:String>
  <x:String x:Key="History.Filter.OlderThanYear">Старше года</x:String>
  <x:String x:Key="History.Visits">посещений</x:String>

