  <!-- Tools page - list items -->
  <x:String x:Key="Tools.VetaleAI.Name">Vetale AI Chat</x:String>
  <x:String x:Key="Tools.VetaleAI.Description">Чат с искусственным интеллектом Vetale</x:String>
  
  <x:String x:Key="Tools.DuckDuckGoAI.Name">DuckDuckGo AI Chat</x:String>
  <x:String x:Key="Tools.DuckDuckGoAI.Description">Бесплатный AI чат от DuckDuckGo</x:String>
  
  <x:String x:Key="Tools.Copilot.Name">Microsoft Copilot</x:String>
  <x:String x:Key="Tools.Copilot.Description">AI ассистент от Microsoft</x:String>
  
