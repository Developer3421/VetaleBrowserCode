  <x:String x:Key="Console.ExportLogs">Экспорт логов</x:String>
  <x:String x:Key="Console.CopyAll">Копировать все видимые логи</x:String>
  <x:String x:Key="Console.CopyMessage">Копировать сообщение</x:String>
