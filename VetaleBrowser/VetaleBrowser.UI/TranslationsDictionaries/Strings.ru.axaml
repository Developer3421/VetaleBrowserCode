  <x:String x:Key="Tools.Replika.Description">AI компаньон для общения</x:String>
  
  <x:String x:Key="Tools.DevTools.Name">Vetale DevTools</x:String>
  <x:String x:Key="Tools.DevTools.Description">Инструменты разработчика</x:String>
  
