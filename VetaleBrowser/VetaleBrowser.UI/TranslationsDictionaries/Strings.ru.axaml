  <x:String x:Key="Tools.History.Description">История посещений</x:String>
  
  <x:String x:Key="Tools.Console.Name">Консоль</x:String>
  <x:String x:Key="Tools.Console.Description">Консоль разработчика с логами и диагностикой</x:String>
  
  <x:String x:Key="Tools.UserAgreement.Name">Пользовательское соглашение</x:String>
  <x:String x:Key="Tools.UserAgreement.Description">Просмотр политики конфиденциальности GDPR и пользовательского соглашения</x:String>
  
  <x:String x:Key="Tools.NavigateButton">→ Перейти в браузере</x:String>

  <!-- Browser Error Pages -->
  <!-- Network Errors -->
  <x:String x:Key="BrowserError.NameNotResolved.Title">Сайт не найден</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Description">Не удалось найти IP-адрес сервера для этого доменного имени. Возможно, сайт не существует или адрес написан с ошибкой.</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip1">Проверьте правильность написания адреса</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip2">Убедитесь, что вы подключены к Интернету</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip3">Попробуйте очистить кеш DNS: ipconfig /flushdns</x:String>

  <x:String x:Key="BrowserError.InternetDisconnected.Title">Нет подключения к Интернету</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Description">Ваше устройство не подключено к Интернету. Проверьте соединение и попробуйте снова.</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip1">Проверьте, включен ли Wi-Fi или подключен кабель</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip2">Перезагрузите роутер или модем</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip3">Обратитесь к вашему интернет-провайдеру</x:String>

  <x:String x:Key="BrowserError.ConnectionRefused.Title">Соединение отклонено</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Description">Сервер активно отклонил попытку подключения. Возможно, сервер не запущен или порт закрыт.</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip1">Убедитесь, что сервер запущен</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip2">Проверьте настройки брандмауэра</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip3">Попробуйте позже</x:String>

  <x:String x:Key="BrowserError.ConnectionTimedOut.Title">Время ожидания истекло</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Description">Сервер слишком долго не отвечает. Это может быть из-за медленного соединения или перегрузки сервера.</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip1">Проверьте скорость вашего Интернета</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip2">Попробуйте обновить страницу</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip3">Попробуйте позже, когда сервер будет менее загружен</x:String>

  <x:String x:Key="BrowserError.ConnectionReset.Title">Соединение прервано</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Description">Соединение с сервером было неожиданно прервано. Это может быть временной проблемой.</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip1">Обновите страницу</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip2">Проверьте соединение с Интернетом</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip3">Отключите VPN или прокси, если используете</x:String>

  <!-- Security Errors -->
  <x:String x:Key="BrowserError.SSLError.Title">Небезопасное соединение</x:String>
  <x:String x:Key="BrowserError.SSLError.Description">Сертификат безопасности этого сайта недействителен или просрочен. Ваши данные могут быть под угрозой.</x:String>
  <x:String x:Key="BrowserError.SSLError.Tip1">Не вводите личные данные на этом сайте</x:String>
  <x:String x:Key="BrowserError.SSLError.Tip2">Проверьте дату и время на вашем устройстве</x:String>
  <x:String x:Key="BrowserError.SSLError.Tip3">Обратитесь к администратору сайта</x:String>

  <!-- Server Errors -->
  <x:String x:Key="BrowserError.EmptyResponse.Title">Пустой ответ</x:String>
  <x:String x:Key="BrowserError.EmptyResponse.Description">Сервер не отправил никаких данных. Возможно, сервер перегружен или неисправен.</x:String>
  <x:String x:Key="BrowserError.EmptyResponse.Tip1">Попробуйте обновить страницу</x:String>
  <x:String x:Key="BrowserError.EmptyResponse.Tip2">Попробуйте позже</x:String>
  <x:String x:Key="BrowserError.EmptyResponse.Tip3">Проверьте статус сервера</x:String>

  <x:String x:Key="BrowserError.TooManyRedirects.Title">Слишком много перенаправлений</x:String>
  <x:String x:Key="BrowserError.TooManyRedirects.Description">Страница создала цикл перенаправлений. Сервер неправильно настроен.</x:String>
  <x:String x:Key="BrowserError.TooManyRedirects.Tip1">Очистите cookies для этого сайта</x:String>
  <x:String x:Key="BrowserError.TooManyRedirects.Tip2">Попробуйте другой браузер</x:String>
  <x:String x:Key="BrowserError.TooManyRedirects.Tip3">Обратитесь в поддержку сайта</x:String>

  <!-- General Errors -->
  <x:String x:Key="BrowserError.BlockedByClient.Title">Заблокировано</x:String>
  <x:String x:Key="BrowserError.BlockedByClient.Description">Загрузка этого ресурса заблокирована браузером или расширением.</x:String>
  <x:String x:Key="BrowserError.BlockedByClient.Tip1">Проверьте настройки блокировщика рекламы</x:String>
  <x:String x:Key="BrowserError.BlockedByClient.Tip2">Временно отключите расширения безопасности</x:String>
  <x:String x:Key="BrowserError.BlockedByClient.Tip3">Добавьте сайт в список исключений</x:String>

  <x:String x:Key="BrowserError.InvalidUrl.Title">Недействительный адрес</x:String>
  <x:String x:Key="BrowserError.InvalidUrl.Description">Введенный адрес имеет неправильный формат и не может быть обработан.</x:String>
  <x:String x:Key="BrowserError.InvalidUrl.Tip1">Проверьте правильность написания URL</x:String>
  <x:String x:Key="BrowserError.InvalidUrl.Tip2">Убедитесь, что URL начинается с http:// или https://</x:String>
  <x:String x:Key="BrowserError.InvalidUrl.Tip3">Попробуйте найти сайт через поиск</x:String>

  <x:String x:Key="BrowserError.FileNotFound.Title">Файл не найден</x:String>
  <x:String x:Key="BrowserError.FileNotFound.Description">Запрошенный файл не существует по указанному адресу.</x:String>
  <x:String x:Key="BrowserError.FileNotFound.Tip1">Проверьте правильность пути к файлу</x:String>
  <x:String x:Key="BrowserError.FileNotFound.Tip2">Убедитесь, что файл существует</x:String>
  <x:String x:Key="BrowserError.FileNotFound.Tip3">Попробуйте перейти на главную страницу сайта</x:String>

  <x:String x:Key="BrowserError.AccessDenied.Title">Доступ запрещен</x:String>
