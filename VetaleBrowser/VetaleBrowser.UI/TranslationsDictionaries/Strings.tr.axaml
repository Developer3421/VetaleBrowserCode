  <x:String x:Key="Unsplash.ApiKey.Step2">2. Kaydolun ve bir uygulama oluşturun</x:String>
  <x:String x:Key="Unsplash.ApiKey.Step3">3. Uygulama ayarlarından Access Key'i kopyalayın</x:String>
  <x:String x:Key="Unsplash.ApiKey.OpenPortal">🔗 Unsplash Developers'ı aç</x:String>
  <x:String x:Key="Unsplash.ApiKey.Note">💡 Unsplash API demo uygulamalar için saatte 50 istek sınırıyla ücretsizdir.</x:String>
  
  <!-- YouTube API -->
  <x:String x:Key="YouTube.ApiKey.Title">YouTube API Yapılandırması</x:String>
  <x:String x:Key="YouTube.ApiKey.Header">YouTube Data API Yapılandır</x:String>
  <x:String x:Key="YouTube.ApiKey.Description">YouTube'da video aramak için API anahtarınızı girin.</x:String>
  <x:String x:Key="YouTube.ApiKey.Label">YouTube API Anahtarı</x:String>
  <x:String x:Key="YouTube.ApiKey.Watermark">YouTube API anahtarınızı girin...</x:String>
  <x:String x:Key="YouTube.ApiKey.HowToGet">📋 API anahtarı nasıl alınır:</x:String>
  <x:String x:Key="YouTube.ApiKey.Step1">1. Google Cloud Console'a gidin</x:String>
  <x:String x:Key="YouTube.ApiKey.Step2">2. Bir proje oluşturun ve YouTube Data API v3'ü etkinleştirin</x:String>
  <x:String x:Key="YouTube.ApiKey.Step3">3. Kimlik Bilgileri bölümünde bir API anahtarı oluşturun</x:String>
