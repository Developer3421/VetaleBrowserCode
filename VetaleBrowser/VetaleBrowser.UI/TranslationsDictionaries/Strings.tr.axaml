  <!-- Ağ Hataları -->
  <x:String x:Key="BrowserError.NameNotResolved.Title">Site bulunamadı</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Description">Bu alan adı için sunucu IP adresi bulunamadı. Site mevcut olmayabilir veya yazım hatası olabilir.</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip1">Adres yazımını kontrol edin</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip2">İnternete bağlı olduğunuzdan emin olun</x:String>
  <x:String x:Key="BrowserError.NameNotResolved.Tip3">DNS önbelleğini temizlemeyi deneyin: ipconfig /flushdns</x:String>

  <x:String x:Key="BrowserError.InternetDisconnected.Title">İnternet bağlantısı yok</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Description">Cihazınız internete bağlı değil. Bağlantınızı kontrol edin ve tekrar deneyin.</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip1">Wi-Fi'nin açık olduğundan veya kablonun bağlı olduğundan emin olun</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip2">Yönlendirici veya modemi yeniden başlatın</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip3">İnternet servis sağlayıcınızla iletişime geçin</x:String>

  <x:String x:Key="BrowserError.ConnectionRefused.Title">Bağlantı reddedildi</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Description">Sunucu bağlantı girişimini aktif olarak reddetti. Sunucu çalışmıyor veya port kapalı olabilir.</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip1">Sunucunun çalıştığından emin olun</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip2">Güvenlik duvarı ayarlarını kontrol edin</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip3">Daha sonra tekrar deneyin</x:String>

  <x:String x:Key="BrowserError.ConnectionTimedOut.Title">Bağlantı zaman aşımına uğradı</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Description">Sunucu yanıt vermesi çok uzun sürdü. Yavaş bağlantı veya sunucu aşırı yükü nedeniyle olabilir.</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip1">İnternet hızınızı kontrol edin</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip2">Sayfayı yenilemeyi deneyin</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip3">Sunucu daha az meşgul olduğunda tekrar deneyin</x:String>

