  <x:String x:Key="Tools.Replika.Name">Replika AI</x:String>
  <x:String x:Key="Tools.Replika.Description">AI компаньйон для спілкування</x:String>
  
  <x:String x:Key="Tools.DevTools.Name">Vetale DevTools</x:String>
  <x:String x:Key="Tools.DevTools.Description">Інструменти розробника</x:String>
  
  <x:String x:Key="Tools.History.Name">Історія</x:String>
  <x:String x:Key="Tools.History.Description">Історія відвідувань</x:String>
  
  <x:String x:Key="Tools.Console.Name">Консоль</x:String>
  <x:String x:Key="Tools.Console.Description">Консоль розробника з логами та діагностикою</x:String>
  
  <x:String x:Key="Tools.NavigateButton">→ Перейти в браузері</x:String>
