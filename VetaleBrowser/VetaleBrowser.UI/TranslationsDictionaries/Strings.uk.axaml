<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Заголовки -->
  <x:String x:Key="App.Title">Vetale Browser</x:String>
  <x:String x:Key="Settings.Title">Налаштування — Vetale Browser</x:String>
  <x:String x:Key="Tools.Title">Інструменти — Vetale Browser</x:String>
  <x:String x:Key="Console.Title">Консоль — Vetale Browser</x:String>
  <x:String x:Key="History.Title">Історія переглядів — Vetale Browser</x:String>
  <x:String x:Key="Bookmarks.Title">Закладки — Vetale Browser</x:String>

  <!-- Головна сторінка налаштувань -->
  <x:String x:Key="Settings.Header">Налаштування</x:String>
  <x:String x:Key="Settings.Language.Title">Мова</x:String>
  <x:String x:Key="Settings.Language.Sub">Обрати мову інтерфейсу</x:String>
