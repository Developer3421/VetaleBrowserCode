  <x:String x:Key="Common.Open">Відкрити</x:String>
  <x:String x:Key="Common.Delete">Видалити</x:String>
  <x:String x:Key="Common.All">Усі</x:String>
  <x:String x:Key="Common.Cancel">Скасувати</x:String>
  <x:String x:Key="Common.Yes">Так</x:String>
  <x:String x:Key="Common.Loading">Завантаження...</x:String>
  <x:String x:Key="Common.ResetDefaults">Повернути до стандартних</x:String>

  <!-- Вкладка -->
  <x:String x:Key="Tab.Mute.Toggle">Перемкнути звук</x:String>

