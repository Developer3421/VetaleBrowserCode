  <!-- Консоль -->
  <x:String x:Key="Console.SearchLogs">Пошук в логах...</x:String>
  <x:String x:Key="Console.AutoRefresh">Авто-оновлення</x:String>
  <x:String x:Key="Console.ExportLogs">Експортувати логи</x:String>
  <x:String x:Key="Console.CopyAll">Скопіювати всі видимі логи у буфер</x:String>
  <x:String x:Key="Console.CopyMessage">Копіювати повідомлення</x:String>
  <x:String x:Key="Console.CopyRow">Копіювати рядок</x:String>
  <x:String x:Key="Console.NoLogs">Немає логів для відображення</x:String>
  <x:String x:Key="Console.NoLogs.Hint">Логи з'являться тут автоматично</x:String>
  <x:String x:Key="Console.InitBanner">Консоль ініціалізовано</x:String>
  <x:String x:Key="Console.ClearConfirm">Ця дія видалить всі записи з консолі. Продовжити?</x:String>
  <x:String x:Key="Console.Level.All">Всі рівні</x:String>
  <x:String x:Key="Console.ExportLogs.FilePrefix">console_logs_</x:String>

  <!-- Tools WebView -->
  <x:String x:Key="Tools.BackToList">Назад до списку</x:String>
  <x:String x:Key="Tools.ToolTitle">Інструмент</x:String>

  <!-- Appearance Tabs page -->
  <x:String x:Key="Appearance.Tabs.Header">Налаштування вкладок</x:String>
  <x:String x:Key="Appearance.Tabs.Width">Ширина вкладки</x:String>
  <x:String x:Key="Appearance.Tabs.WidthPx">Ширина (px):</x:String>
  <x:String x:Key="Appearance.Tabs.ElementsSize">Розмір елементів</x:String>
  <x:String x:Key="Appearance.Tabs.TextSizePx">Розмір тексту (px):</x:String>
  <x:String x:Key="Appearance.Tabs.IconSize">Розмір іконки</x:String>
  <x:String x:Key="Appearance.Tabs.IconSizePx">Розмір іконки (px):</x:String>
