  <x:String x:Key="Settings.Appearance.Sub">Налаштувати вигляд та стиль</x:String>
  <x:String x:Key="Settings.Search.Title">Пошукова система</x:String>
  <x:String x:Key="Settings.Search.Sub">Виберіть пошукову систему за замовчуванням</x:String>

  <!-- Кнопки вікна -->
