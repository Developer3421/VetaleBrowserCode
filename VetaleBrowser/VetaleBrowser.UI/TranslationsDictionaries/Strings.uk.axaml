  <x:String x:Key="Bookmarks.Header">Закладки</x:String>
  <x:String x:Key="Bookmarks.Add">Додати закладку</x:String>
  <x:String x:Key="Bookmarks.Folder.Default">Закладки</x:String>
  <x:String x:Key="Bookmarks.Folder.Work">Робота</x:String>
  <x:String x:Key="Bookmarks.Folder.Personal">Особисті</x:String>
  <x:String x:Key="Bookmarks.Folder.News">Новини</x:String>
  
