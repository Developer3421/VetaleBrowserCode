  <x:String x:Key="Appearance.Tabs.TextColor">Колір тексту вкладки</x:String>
  <x:String x:Key="Appearance.Tabs.ActiveColor">Колір активної вкладки</x:String>
  <x:String x:Key="Appearance.ColorHex">Колір (HEX):</x:String>
  <x:String x:Key="Appearance.SaveSettings">Зберегти налаштування</x:String>

  <!-- Розміри та іконки -->
  <x:String x:Key="Common.WidthPx">Ширина (px):</x:String>
  <x:String x:Key="Common.HeightPx">Висота (px):</x:String>
  <x:String x:Key="Common.SizePx">Розмір (px):</x:String>
  <x:String x:Key="Common.IconSizePx">Розмір іконки (px):</x:String>

  <!-- Appearance Main Window -->
  <x:String x:Key="Appearance.MainWindow.Header">Налаштування головного вікна</x:String>
  <x:String x:Key="Appearance.MainWindow.NavBarColor">Колір навігаційного бару</x:String>
  <x:String x:Key="Appearance.MainWindow.NavBarHeight">Висота навігаційного бару</x:String>
  <x:String x:Key="Appearance.MainWindow.Width">Ширина головного вікна</x:String>
  <x:String x:Key="Appearance.MainWindow.Height">Висота головного вікна</x:String>
  <x:String x:Key="Appearance.MainWindow.TopBarBackgroundColor">Колір фону верхньої лінії</x:String>
