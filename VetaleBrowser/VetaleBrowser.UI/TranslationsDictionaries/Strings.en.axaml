  <!-- About Window -->
  <x:String x:Key="About.Version">Version 1.0</x:String>
  <x:String x:Key="About.Creator.Label">Creator</x:String>
  <x:String x:Key="About.Creator.Name">Oleg Kurylo</x:String>
  <x:String x:Key="About.CreationDate.Label">Creation Date</x:String>
  <x:String x:Key="About.CreationDate.Value">December 15, 2025</x:String>
  <x:String x:Key="About.Description">Vetale Browser is a modern web browser built from scratch. The creator went through a long journey from the very first WPF version to this current Avalonia UI version. The browser features built-in AI assistant, developer tools, download manager, and many other features designed for comfortable web browsing.</x:String>
  <x:String x:Key="About.Technologies.Label">Technologies</x:String>
  <x:String x:Key="About.Copyright">© 2025 Oleg Kurylo. All rights reserved.</x:String>
  
