  <x:String x:Key="BrowserError.InternetDisconnected.Tip1">Check if Wi-Fi is enabled or cable is connected</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip2">Restart your router or modem</x:String>
  <x:String x:Key="BrowserError.InternetDisconnected.Tip3">Contact your Internet service provider</x:String>

  <x:String x:Key="BrowserError.ConnectionRefused.Title">Connection refused</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Description">The server actively refused the connection attempt. The server may not be running or the port is closed.</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip1">Make sure the server is running</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip2">Check firewall settings</x:String>
  <x:String x:Key="BrowserError.ConnectionRefused.Tip3">Try again later</x:String>

  <x:String x:Key="BrowserError.ConnectionTimedOut.Title">Connection timed out</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Description">The server took too long to respond. This could be due to slow connection or server overload.</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip1">Check your Internet speed</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip2">Try refreshing the page</x:String>
  <x:String x:Key="BrowserError.ConnectionTimedOut.Tip3">Try again later when server is less busy</x:String>

  <x:String x:Key="BrowserError.ConnectionReset.Title">Connection reset</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Description">The connection to the server was unexpectedly interrupted. This may be a temporary issue.</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip1">Refresh the page</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip2">Check your Internet connection</x:String>
  <x:String x:Key="BrowserError.ConnectionReset.Tip3">Disable VPN or proxy if using one</x:String>

