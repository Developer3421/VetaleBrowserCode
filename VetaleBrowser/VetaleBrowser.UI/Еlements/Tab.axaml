<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Еlements">
    <Design.PreviewWith>
        <StackPanel Spacing="5" Margin="20">
            <controls:Tab Title="Active Tab" IsActive="True" Width="200" />
            <controls:Tab Title="Inactive Tab" IsActive="False" Width="200" />
            <controls:Tab Title="Very Long Tab Title Example" IsActive="False" Width="200" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="controls|Tab">
        <Setter Property="Height" Value="38" />
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="MaxWidth" Value="240" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        CornerRadius="8,8,0,0"
                        Padding="12,0,8,0"
                        ClipToBounds="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#DDD6FE" Offset="0" />
                            <GradientStop Color="#C4B5FD" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <!-- Mute Button (left of favicon) -->
                        <Button Grid.Column="0"
                                x:Name="PART_MuteButton"
                                Width="20"
                                Height="20"
                                Margin="0,0,6,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                ToolTip.Tip="{DynamicResource Tab.Mute.Toggle}">
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- Speaker icon - gray when unmuted, white when muted -->
                                <Path Data="M2,6 L6,6 L10,2 L10,18 L6,14 L2,14 Z M12,6 C13,7 13,11 12,12"
                                      Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="2"
                                      x:Name="PART_SpeakerIcon"/>
                                
                                <!-- Slash when muted -->
                                <Path Data="M3,3 L13,15"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      IsVisible="{TemplateBinding IsMuted}"
                                      x:Name="PART_MuteSlash"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <!-- Favicon/Icon -->
                        <Border Grid.Column="1"
                                Width="24"
                                Height="24"
                                Margin="0,0,8,0"
                                CornerRadius="3"
                                Background="#A78BFA">
                            <Grid>
                               
                                <!-- Actual favicon image (renders over fallback when available) -->
                                <Image Source="{TemplateBinding FaviconSource}"
                                       Width="24"
                                       Height="24"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Title -->
                        <TextBlock Grid.Column="2"
                                   x:Name="PART_Title"
                                   Text="{TemplateBinding Title}"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="#D84315"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,8,0" />

                        <!-- Close Button -->
                        <Button Grid.Column="3"
                                x:Name="PART_CloseButton"
                                Width="20"
                                Height="20"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                IsVisible="{TemplateBinding IsCloseButtonVisible}">
                            <Image Source="{DynamicResource CloseTabButtonImage}"
                                   Width="14"
                                   Height="14"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Inactive Tab State (Default) -->
    <Style Selector="controls|Tab:not(:active)">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="controls|Tab:not(:active) /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#F3F4F6" Offset="0" />
                <GradientStop Color="#E5E7EB" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <!-- Active Tab State -->
    <Style Selector="controls|Tab:active">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="controls|Tab:active /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#DDD6FE" Offset="0" />
                <GradientStop Color="#C4B5FD" Offset="1" />
            </LinearGradientBrush>
        </Setter>
        <Setter Property="BorderThickness" Value="1,1,1,0" />
        <Setter Property="BorderBrush" Value="#A78BFA" />
    </Style>

    <Style Selector="controls|Tab:active /template/ TextBlock#PART_Title">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#D84315" />
    </Style>

    <!-- Hover Effects -->
    <Style Selector="controls|Tab:pointerover /template/ Border#PART_Border">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <Style Selector="controls|Tab:not(:active):pointerover /template/ Border#PART_Border">
        <Setter Property="Background">
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FAF9FF" Offset="0" />
                <GradientStop Color="#F3F1FF" Offset="1" />
            </LinearGradientBrush>
        </Setter>
    </Style>

    <!-- Close Button Hover -->
    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pointerover">
        <Setter Property="Background" Value="#DDD6FE" />
    </Style>

    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pointerover /template/ Image">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- Close Button Press -->
    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pressed">
        <Setter Property="Background" Value="#C4B5FD" />
    </Style>

    <Style Selector="controls|Tab /template/ Button#PART_CloseButton:pressed /template/ Image">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Mute Button Hover -->
    <Style Selector="controls|Tab /template/ Button#PART_MuteButton:pointerover">
        <Setter Property="Background" Value="#E0E0E0" />
    </Style>

    <!-- Mute Button Press -->
    <Style Selector="controls|Tab /template/ Button#PART_MuteButton:pressed">
        <Setter Property="Background" Value="#D0D0D0" />
    </Style>

    <!-- Mute Button - Muted State Background -->
    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton">
        <Setter Property="Background" Value="#FFA726" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton:pointerover">
        <Setter Property="Background" Value="#FF9800" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Button#PART_MuteButton:pressed">
        <Setter Property="Background" Value="#FB8C00" />
    </Style>

    <!-- Mute Button Icon Colors -->
    <Style Selector="controls|Tab[IsMuted=false] /template/ Path#PART_SpeakerIcon">
        <Setter Property="Fill" Value="#666666" />
    </Style>

    <Style Selector="controls|Tab[IsMuted=true] /template/ Path#PART_SpeakerIcon">
        <Setter Property="Fill" Value="#FFFFFF" />
    </Style>
</Styles>
