<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Еlements">
    <Design.PreviewWith>
        <controls:NavigationBar Width="800" />
    </Design.PreviewWith>

    <Style Selector="controls|NavigationBar">
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="8,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        
                        <!-- Back Button -->
                        <Button Grid.Column="0"
                                x:Name="PART_BackButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Назад">
                            <Image Width="20"
                                   Height="20"
                                   Source="/VetaleBrowser.UI/Sources/Icons/Backbutton.png"
                                   Stretch="Uniform"/>
                        </Button>

                        <!-- Forward Button -->
                        <Button Grid.Column="1"
                                x:Name="PART_ForwardButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Вперед">
                            <Image Width="20"
                                   Height="20"
                                   Source="/VetaleBrowser.UI/Sources/Icons/ForwardButton.png"
                                   Stretch="Uniform"/>
                        </Button>

                        <Button Grid.Column="2"
                                x:Name="PART_ReloadButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Оновити">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="#FFFFFF"
                                  Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                        </Button>

                        <!-- Home Button -->
                        <Button Grid.Column="3"
                                x:Name="PART_HomeButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Домівка">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="#FFFFFF"
                                  Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                        </Button>

                        <!-- Address Bar -->
                        <Border Grid.Column="4"
                                Background="#FFFFFF"
                                CornerRadius="18"
                                Margin="0,0,8,0"
                                BorderThickness="1"
                                BorderBrush="#E0E0E0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <!-- Lock/Security Icon -->
                                <Border Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        Margin="12,0,8,0">
                                    <Path Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Fill="#4CAF50"
                                          Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                                </Border>

                                <!-- URL TextBox -->
                                <TextBox Grid.Column="1"
                                         x:Name="PART_AddressBar"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalAlignment="Center"
                                         Watermark="Введіть URL або пошуковий запит..."
                                         FontSize="13"
                                         Padding="0,6"/>

                                <!-- Bookmark/Star Icon -->
                                <Button Grid.Column="2"
                                        x:Name="PART_BookmarkButton"
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,8,0"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        ToolTip.Tip="Додати в закладки">
                                    <Path Width="14"
                                          Height="14"
                                          Stretch="Uniform"
                                          Fill="#FFA726"
                                          Data="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Tools Button -->
                        <Button Grid.Column="5"
                                x:Name="PART_ToolsButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Інструменти">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="#FFFFFF"
                                  Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
                        </Button>

                        <!-- Settings Button -->
                        <Button Grid.Column="6"
                                x:Name="PART_SettingsButton"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="Налаштування">
                            <Path Width="14"
                                  Height="14"
                                  Stretch="Uniform"
                                  Fill="#FFFFFF"
                                  Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                        </Button>

                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Button hover effects -->
    <Style Selector="controls|NavigationBar /template/ Button:pointerover">
        <Setter Property="Background" Value="#50FFFFFF" />
    </Style>

    <Style Selector="controls|NavigationBar /template/ Button:pressed">
        <Setter Property="Background" Value="#30FFFFFF" />
    </Style>

    <!-- Address bar focus effect -->
    <Style Selector="controls|NavigationBar /template/ TextBox#PART_AddressBar:focus /template/ Border">
        <Setter Property="BorderBrush" Value="#A78BFA" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

</Styles>
