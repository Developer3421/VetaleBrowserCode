<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Еlements"
        xmlns:searchmodels="clr-namespace:VetaleBrowser.VetaleBrowser.Search.Models;assembly=VetaleBrowser">
    <Design.PreviewWith>
        <controls:NavigationBar Width="800" />
    </Design.PreviewWith>

    <Style Selector="controls|NavigationBar">
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="8,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto">
                        
                        <!-- Back Button -->
                        <Button Grid.Column="0"
                                x:Name="PART_BackButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="0"
                                ToolTip.Tip="{DynamicResource Nav.Back}">
                            <Image
                                Source="/VetaleBrowser.UI/Sources/Icons/Backbutton.png"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </Button>

                        <!-- Forward Button -->
                        <Button Grid.Column="1"
                                x:Name="PART_ForwardButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="0"
                                ToolTip.Tip="{DynamicResource Nav.Forward}">
                            <Image
                                Source="/VetaleBrowser.UI/Sources/Icons/ForwardButton.png"
                                Stretch="UniformToFill"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch" />
                        </Button>

                        <Button Grid.Column="2"
                                x:Name="PART_ReloadButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="{DynamicResource Common.Refresh}"
                                Padding="0">
                            <Image Source="{DynamicResource ReloadTabButtonImage}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>

                        <!-- Home Button -->
                        <Button Grid.Column="3"
                                x:Name="PART_HomeButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="{DynamicResource Nav.Home}"
                                Padding="0">
                            <Image Source="{DynamicResource HomeButtonImage}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>

                        <!-- Address Bar -->
                        <Border Grid.Column="4"
                                Background="#F3E8FF"
                                CornerRadius="18"
                                Margin="0,0,8,0"
                                BorderThickness="1"
                                BorderBrush="#C4B5FD">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                                <!-- Lock/Security Icon -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        Width="20"
                                        Height="20"
                                        Margin="12,0,8,0">
                                    <Path Width="12"
                                          Height="12"
                                          Stretch="Uniform"
                                          Fill="#4CAF50"
                                          Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                                </Border>

                                <!-- URL TextBox -->
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         x:Name="PART_AddressBar"
                                         BorderThickness="0"
                                         Background="#F3E8FF"
                                         Foreground="#4C1D95"
                                         VerticalAlignment="Center"
                                         Watermark="{DynamicResource Nav.AddressBar.Watermark}"
                                         FontSize="13"
                                         Padding="0,6"/>

                                <!-- Bookmark/Star Icon -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        x:Name="PART_BookmarkButton"
                                        Width="28"
                                        Height="28"
                                        Margin="4,0,8,0"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        ToolTip.Tip="{DynamicResource Bookmarks.Add}"
                                        Padding="0">
                                    <Image Source="{DynamicResource AddBookmarkButtonImage}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                </Button>

                                <!-- Suggestions Popup -->
                                <Popup Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                       x:Name="PART_SuggestionsPopup"
                                       PlacementTarget="{Binding #PART_AddressBar}"
                                       Placement="Bottom"
                                       IsLightDismissEnabled="True"
                                       IsOpen="False"
                                       MaxWidth="600">
                                    <Border Background="White" CornerRadius="12" Padding="4" BoxShadow="0 4 16 #26000000">
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="PART_SuggestionsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="searchmodels:SearchSuggestion">
                                                        <Border Padding="8" CornerRadius="6" Background="Transparent">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{Binding Icon}" FontSize="14"/>
                                                                <TextBlock Text="{Binding Text}" FontSize="14"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>

                        <!-- Tools Button -->
                        <Button Grid.Column="5"
                                x:Name="PART_ToolsButton"
                                Width="32"
                                Height="32"
                                Margin="0,0,4,0"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="{DynamicResource Tools.Button.Tooltip}"
                                Padding="0">
                            <Image Source="{DynamicResource InstrumentsButtonImage}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>

                        <!-- Settings Button -->
                        <Button Grid.Column="6"
                                x:Name="PART_SettingsButton"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                CornerRadius="6"
                                ToolTip.Tip="{DynamicResource Settings.Button.Tooltip}"
                                Padding="0">
                            <Image Source="{DynamicResource SettingsButtonImage}"
                                   Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch" />
                        </Button>

                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Button hover effects -->
    <Style Selector="controls|NavigationBar /template/ Button:pointerover">
        <Setter Property="Background" Value="#50FFFFFF" />
    </Style>

    <Style Selector="controls|NavigationBar /template/ Button:pressed">
        <Setter Property="Background" Value="#30FFFFFF" />
    </Style>

    <!-- Address bar focus effect -->
    <Style Selector="controls|NavigationBar /template/ TextBox#PART_AddressBar:focus /template/ Border">
        <Setter Property="BorderBrush" Value="#A78BFA" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- Force background and foreground on the address TextBox to ensure visible light-purple background -->
    <Style Selector="controls|NavigationBar /template/ TextBox#PART_AddressBar">
        <Setter Property="Background" Value="#F3E8FF" />
        <Setter Property="Foreground" Value="#4C1D95" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

</Styles>
