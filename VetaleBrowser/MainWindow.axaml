<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Еlements"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="VetaleBrowser.MainWindow"
        Title="Vetale Browser"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#FF8B4513"
        BorderThickness="0.5"
        BorderBrush="#22000000"
        
        CanResize="True"
        MinWidth="480"
        MinHeight="320"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        UseLayoutRounding="True">

    <!-- Resources: gradients adapted from your snippet -->
    <Window.Resources>
        <!-- Футуристичний сірий градієнт -->
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Футуристичний фіолетовий градієнт -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Еlements/Tab.axaml"/>
        
        <!-- Glass style (colors taken from provided WPF snippet) -->
        <Style Selector="Border.glass-panel">
            <!-- Visual background only; no border or shadow -->
            <Setter Property="Background" Value="{StaticResource GrayGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

        <!-- Toolbar buttons etc. (kept minimal) -->
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Slightly smaller & tighter controls like modern browsers -->
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>

        <!-- Default style for the Close button: white background so a red PNG icon is visible -->
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="#FFFFFFFF"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Hover style for Close button: subtle red tint (keeps icon visible) -->
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#FFFFEBE8"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Top row: tab bar with window controls -->
        <Grid Grid.Row="0" Margin="0" Height="42" 
              Background="{StaticResource GrayGradient}"
              PointerPressed="TopBar_PointerPressed" DoubleTapped="TopBar_DoubleTapped">
            <Grid ColumnDefinitions="*,Auto">
                <!-- left area - tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,4,0,0">
                    <controls:Tab Title="Vetale Browser" IsActive="True" Width="200" />
                </StackPanel>

                <!-- window controls on the right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Classes="window-control" Click="MinimizeWindow" ToolTip.Tip="Minimize" Padding="0">
                        <Image Source="{DynamicResource MinButtonImage}" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="window-control" Click="MaximizeWindow" ToolTip.Tip="Maximize" Padding="0">
                        <Image Source="{DynamicResource MaxButtonImage}" Stretch="Uniform"/>
                    </Button>
                    <Button Classes="window-control close" Click="CloseWindow" ToolTip.Tip="Close" Padding="0" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <Image Source="{DynamicResource CloseButtonImage}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Middle row: Navigation Bar -->
        <Grid Grid.Row="1" Background="{StaticResource PurpleGradient}" Height="36">
            <controls:NavigationBar x:Name="NavigationBar" />
        </Grid>

        <!-- Bottom row: WebView container -->
        <Grid Grid.Row="2" Background="#FFFFFF" x:Name="WebViewContainer">
            <TextBlock Text="Ініціалізація WebView..." 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Foreground="#A0A0A0" 
                       FontSize="16"/>
        </Grid>
     </Grid>
 </Window>
