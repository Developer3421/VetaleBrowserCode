<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:VetaleBrowser.VetaleBrowser.UI.Еlements"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="VetaleBrowser.MainWindow"
        Title="{DynamicResource App.Title}"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="BorderOnly"
        Background="#FF8B4513"
        BorderThickness="0.5"
        BorderBrush="#22000000"
        
        CanResize="True"
        MinWidth="480"
        MinHeight="320"
        Padding="8"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        UseLayoutRounding="True">

    <!-- Resources: gradients adapted from your snippet -->
    <Window.Resources>
        <!-- Футуристичний сірий градієнт -->
        <LinearGradientBrush x:Key="GrayGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE0E0E0" Offset="0"/>
            <GradientStop Color="#FFD0D0D0" Offset="0.3"/>
            <GradientStop Color="#FFC5C5C5" Offset="0.7"/>
            <GradientStop Color="#FFC0C0C0" Offset="1"/>
        </LinearGradientBrush>

        <!-- Футуристичний фіолетовий градієнт -->
        <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFA020F0" Offset="0"/>
            <GradientStop Color="#FF9A1CE8" Offset="0.3"/>
            <GradientStop Color="#FF8E15DC" Offset="0.7"/>
            <GradientStop Color="#FF8612D0" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://VetaleBrowser/VetaleBrowser.UI/Еlements/Tab.axaml"/>
        
        <!-- Glass style (colors taken from provided WPF snippet) -->
        <Style Selector="Border.glass-panel">
            <!-- Visual background only; no border or shadow -->
            <Setter Property="Background" Value="{StaticResource GrayGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

        <!-- Toolbar buttons etc. (kept minimal) -->
        <Style Selector="Button.window-control">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#303030"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- Slightly smaller & tighter controls like modern browsers -->
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.window-control:pointerover">
            <Setter Property="Background" Value="#40FFFFFF"/>
        </Style>

        <!-- Default style for the Close button: remove opaque white background so icon isn't boxed -->
        <Style Selector="Button.window-control.close">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Hover style for Close button: subtle translucent red tint (no hard white) -->
        <Style Selector="Button.window-control.close:pointerover">
            <Setter Property="Background" Value="#40FF5C5C"/>
            <Setter Property="Foreground" Value="#FF000000"/>
        </Style>
    </Window.Styles>

    <!-- Content area: will switch between NormalModePage and FullscreenModePage -->
    <ContentControl x:Name="PageContainer" />
 </Window>
